@using UI.EmployerPortal.Web.Features.Shared.Accounts.Models
@inject NavigationManager Nav
<header class="billing-header" role="banner" aria-label="Account balance summary">
    <div class="billing-header-content fs-sm">
        <span class="detail-label fw-bold" id="balance-due-label">@HeaderText</span>
        <div class="billing-header-right">
            <span class="balance-amount fw-bold"
                  aria-labelledby="balance-due-label"
                  aria-live="polite"
                  aria-atomic="true">
                @Amount?.ToString("C")
            </span>
            @* <a href="@ReturnUrl" class="amount-due-link" aria-label="View amount due details for your account">
                @LinkText
            </a> *@
            <a href="javascript:void(0);" onclick="@HandleAmountDueLink"
               class="ach-amount-due-link"
               aria-label="View Amount Due Details">
                Amount Due Details
            </a>
        </div>
    </div>
</header>

@code {
    //[Parameter] public EmployerAccount? EmployerAccount { get; set; }
    [Parameter] public string? HeaderText { get; set; } = "Balance Due";
    [Parameter] public string? LinkText { get; set; } = "Amount Due Details";
    [Parameter] public decimal? Amount { get; set; } = 0;
    [Parameter] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            ReturnUrl = "billing-payments";
        }
    }

    private void HandleAmountDueLink()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.Contains("voluntary-contribution"))
        {
            Nav.NavigateTo("billing-payments/voluntary-contribution");
        }
        else
        {
            Nav.NavigateTo("billing-payments/billing");
        }
    }
}
