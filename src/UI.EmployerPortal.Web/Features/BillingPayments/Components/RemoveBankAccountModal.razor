@using UI.EmployerPortal.Razor.SharedComponents
@using UI.EmployerPortal.Razor.SharedComponents.Helpers
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop;

@if (IsVisible)
{
    <div class="modal-overlay" role="presentation">
        <div class="modal-container"
             role="dialog"
             aria-modal="true"
             aria-labelledby="remove-bank-modal-title"
             aria-describedby="remove-bank-modal-body"
             @onkeydown="HandleKeyDown"
             @ref="_modalRef">
            <div class="modal-header">
                <h3 id="remove-bank-modal-title" class="modal-title">Delete Bank Account?</h3>
                <button class="modal-close" @onclick="OnCancel" aria-label="Close">
                    <img src="icons/close_x_blue.svg" />
                </button>
            </div>
            <div id="remove-bank-modal-body" class="modal-body">
                <p>
                    Are you sure you want to delete this bank account?
                </p>
            </div>
            <div class="modal-footer">
                <Button Variant="Button.ButtonVariant.Secondary"
                        type="button"
                        ShowBorder="false"
                        OnClick="OnCancel">
                    CANCEL
                </Button>
                <Button Variant="Button.ButtonVariant.Secondary"
                        type="button"
                        OnClick="OnConfirm">
                    CONFIRM
                </Button>
            </div>
        </div>
    </div>
}
@code {
    [Inject] private IJSRuntime JSRuntime {get;set;} = default!;
    [Parameter] public bool IsVisible { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private ElementReference _modalRef;
    private bool _wasVisible;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_wasVisible)
        {
            _wasVisible = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FilterDrawer.js");
            await _module.InvokeVoidAsync("openFocusTrap", _modalRef);
        }
        else if (!IsVisible && _wasVisible)
        {
            _wasVisible = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("closeFocusTrap");
            }
        }
    }
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        //Escape key dismissal
        if (e.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
    }
}
