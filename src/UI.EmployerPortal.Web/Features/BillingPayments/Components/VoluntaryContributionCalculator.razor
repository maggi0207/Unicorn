@using Microsoft.FluentUI.AspNetCore.Components
@using UI.EmployerPortal.Razor.SharedComponents.TextBoxes
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using UI.EmployerPortal.Razor.SharedComponents.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using UI.EmployerPortal.Web.Features.Shared.Layout.Components

<div class="voluntary-Container" role="region" aria-label="Voluntary Contribution">
 @if (_showValidationSummary && _validationErrors.Any())
{
    <div class="fix-section-width" style="max-width:684px;">       
        <NotificationBanner NotificationType="NotificationType.Alert"
                            MessageStyle="MessageStyle.MultiLine"
                            Messages="_validationErrors"
                            DismissButton="false" />
        

    </div>
}
<EditForm EditContext="_editContext"
          OnValidSubmit="HandleContinue"
          OnInvalidSubmit="OnInvalid">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <h2 class="title-heading">Voluntary Contribution Calculator</h2>
    <p class="title-smallheading">
        Voluntary contributions are an optional means by which employers can lower their rate by one rate bracket.
    </p>
    <p class="title-smallheading">
        Voluntary contributions must be received by November 30th to obtain a lower rate for the upcoming year.
    </p>
    <table class="table" aria-label="Contribution Details">
        <tbody>
            <tr>
                    <th scope="row" class="col1">Reserve Fund Balance as of June 30,@DateTime.Now.Year</th>
                <th scope="row" class="col2">@Model.ReserveFundBalance.ToString("C")</th>
            </tr>
            <tr>
                    <th scope="row" class="col1">Taxable Payroll Fiscal Year Ended June 30,@DateTime.Now.Year</th>
                <th scope="row" class="col2">@Model.TaxablePayRoll.ToString("C")</th>
            </tr>
            <tr>
                <th scope="row" class="col1">Reserve Fund Percentage</th>
                <th scope="row" class="col2">@Model.ReserveFundPercentage.ToString("P2")</th>
            </tr>
            <tr>
                <th scope="row" class="col1">Tax Rate For Year @(DateTime.Now.Year +1)</th>
                <th scope="row" class="col2">@Model.TaxRateForYear.ToString("P2")</th>
            </tr>
         </tbody>
    </table>
    <p class="sub-header">You are eligible to make a voluntary contribution to lower your @(DateTime.Now.Year +1) tax rate to @Model.Lowerrate.ToString("P2").</p>
     <div class="taxable-payroll-row">
            <div class="taxable-payroll-info">
                <div class="title">
                   Estimated Taxable Payroll for @(DateTime.Now.Year + 1)
                </div>
 
                <div class="subtitle">
                    Change if needed and press Recalculate
                </div>
            </div>
            <div class="taxable-payroll-actions" aria-label="Estimated Taxable Payroll For @(DateTime.Now.Year + 1)">
                <button type="button" class="recalculate-btn"  @onclick="() => RecalculatePayment()">
                    <img src="@Assets["icons/recalculate.svg"]" class="action-icon" alt="" /> Recalculate
                </button>
 
                <div class="value">
                    <NumericTextBox Value="@Model.EstimatedTaxablePayroll"
                                    Id="amount"
                                    AriaLabel="Estimate Amount to pay"
                                    IsReadonly="false"
                                    InputType="@InputDataTypes.Currency"
                                    ShowCurrencyIcon="false"
                                    DecimalPlaces="2"
                                    Min="0"
                                    Max="1000000000"
                                    CssClass="@($"form-control amount-input {(_amountHasError ? "numeric-input--error" : string.Empty)}")" />
                    <ValidationMessage For="@(() => Model.EstimatedTaxablePayroll)" />
                </div>
            </div>        
        </div>
        <div class="custom-divider"></div>
                
  <table class="table" aria-label="Contribution Tax Details">
        <tbody>
            
            <tr>
                <th scope="row" class="col1">Tax Savings Based On estimated payroll</th>
                <th scope="row" class="col2">@Model.EstimatedTaxablePayroll.ToString("C")</th>
            </tr>
            <tr>
                <th scope="row" class="col1">Voluntary contribution required to lower your @(DateTime.Now.Year +1) rate</th>
                    <th scope="row" class="col2">@Model.VcRequired.ToString("C")</th>
            </tr>
            <tr>
                <th scope="row" class="col1">Net tax savings for @(DateTime.Now.Year +1)</th>
                    <th scope="row" class="col2">@Model.NetTaxSavings.ToString("C")</th>
            </tr>
            <tr>

            </tr>
            <tr>
                <th scope="row" class="col1">Voluntary Contribution Payment Amount</th>
                    <th scope="row" class="col2">
                        <span class="value">
                            <NumericTextBox Value="@Model.PaymentAmount"
                                            Id="amount"
                                            AriaLabel="Contribution Amount to pay"
                                            IsReadonly="false"
                                            InputType="@InputDataTypes.Currency"
                                            ShowCurrencyIcon="false"
                                            DecimalPlaces="2"
                                            Min="0"
                                            Max="1000000000"
                                            CssClass="@($"form-control amount-input {(_amountHasError ? "numeric-input--error" : string.Empty)}")"
                                            ValueChanged="OnAmountChanged" />
                            <ValidationMessage For="@(() => Model.PaymentAmount)" />
                        </span>
                    </th>
         </tr>
        </tbody>
    </table>   
        <h3 id="payment-method-heading" class="payment">
            Payment Method
        </h3>
    <fieldset aria-labelledby="payment-method-heading"
                  class="@(_paymentMethodHasError ? "billing-fieldset-error" : string.Empty)"
                  aria-invalid="@(_paymentMethodHasError ? "true" : "false")">
            <div class="option">
            <label for="ach">
            <input type="radio"
                   id="ach"
                   name="paymentMethod"
                   value="ACH"
                   checked="@(_selectedpayment == "ACH")"
                   @onchange="OnpaymentChanged"
                   aria-label="ACH payment method" />           
                <strong>ACH</strong>   <br/>
                 <div class="description">
                      Pay your UI taxes online directly from your bank account.
                </div>
            </label> 
        </div>
 
        <div class="option">
            <label for="card">
            <input type="radio"
                   id="card"
                   name="paymentMethod"
                   value="Card"
                   checked="@(_selectedpayment == "Card")"
                   @onchange="OnpaymentChanged"
                   aria-label="Credit or Debit Card payment method" />           
                <strong>Credit/Debit Card</strong>  <br />
                <div class="description">
                    Make a payment by credit or debit card.
                </div>
            </label>
        </div>
 
        <div class="option">
            <label for="check">
            <input type="radio"
                   id="check"
                   name="paymentMethod"
                   value="Check"
                   checked="@(_selectedpayment == "Check")"
                   @onchange="OnpaymentChanged"
                   aria-label="Check payment method" />          
                <strong>Check</strong>   <br />
                <div class="description">
                    Print out a payment coupon you can send in to us with your payment.
                </div>
            </label>
        </div>
    </fieldset>
        <BillingButtonBar ShowBack="true"
                          ShowContinue="true"
                          ShowCancel="false"
                          OnContinue="PaymentAsync"
                          ContinueText="CONTINUE"
                          ButtonWidth="200"
                          OnBack="GoBack">
        </BillingButtonBar>

        <h3 id="payment-method-heading" class="section-title">
            Disclaimer
        </h3>
        <p class="section-paragraph">
          @Model.DisclaimerText
        </p>
    </EditForm>
</div>

