@using UI.EmployerPortal.Web.Features.Shared.Components
@inject NavigationManager Nav;

<PageHeader Text="Voluntary Contribution Calculator" />

<div>
    @if (!_isAvailable)
    {
        <div class="info-panel">
            <div class="info-panel-row">
                <img src="@Assets["icons/information-notification.svg"]" class="info-panel-icon" width="16" height="16" aria-hidden="true" alt="" />
                <div class="info-panel-text">
                    <p class="fw-bold info-panel-title">Voluntary contribution payments can’t be made at this time.</p>
                    <p class="fw-bold">
                        The voluntary contribution calculator is available early to mid October. Voluntary<br />
                        contribution payments must be submitted by November 30th.
                    </p>
                </div>
            </div>
        </div>
    }
    else if (!_isEligiblebyacc)
    {
        <div class="info-panel-type">
            <div class="info-panel-row">
                <img src="@Assets["icons/information-notification.svg"]" class="info-panel-icon" width="16" height="16" aria-hidden="true" alt="" />
                <div class="info-panel-text">
                    <p class="fw-bold info-panel-title">Your account is not eligible for a voluntary contribution. @_ineligibilityReason</p>
                </div>
            </div>
        </div>
        <br />
        <p class="title-smallheading">
            Voluntary contributions are an optional means by which employers can lower their rate by one rate bracket.
        </p>
        <p class="title-smallheading">
            Voluntary contributions must be received by November 30th to obtain a lower rate for the upcoming year.
        </p>
    }
</div>

<BillingButtonBar ShowBack="true"
                  ShowContinue="false"
                  ShowCancel="false"
                  ButtonWidth="200"
                  OnBack="GoBack">
</BillingButtonBar>

@code {
    [Parameter]
    public bool _isEligiblebyacc { get; set; }

    [Parameter]
    public bool _isAvailable { get; set; } = true;

    [Parameter]
    public string? _ineligibilityReason { get; set; }

    private void GoBack()
    {
        Nav.NavigateTo("billing-payments/payment-options?source=flow");
    }
}
