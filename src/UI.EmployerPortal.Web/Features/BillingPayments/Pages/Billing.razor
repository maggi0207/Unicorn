@page "/billing-payments/billing"
@using UI.EmployerPortal.Razor.SharedComponents
@using UI.EmployerPortal.Web.Auth
@using UI.EmployerPortal.Web.Features.Dashboard
@using UI.EmployerPortal.Web.Features.BillingPayments.Components
@using UI.EmployerPortal.Web.Features.Shared.Accounts.Models
@inherits UI.EmployerPortal.Web.Auth.EmployerAuthorizedPage
@inject IDashboardOrchestrator DashboardOrchestrator
@inject NavigationManager Nav

<PageTitle>Billing Details</PageTitle>
@*<div class="section-page">
    <h1 class="section-header fw-bold">Billing</h1>
    <p class="section-description">You are in the Billing section.</p>*@
    @if (_istaxable)
{
    var baseUri = new Uri(Nav.BaseUri);
    var pathBase = new PathString(baseUri.AbsolutePath.TrimEnd('/') + "/billing-payments/billing-detail");
     Nav.NavigateTo(pathBase);
  
}
else
{
    <BillDetailReimbursable></BillDetailReimbursable>
}
