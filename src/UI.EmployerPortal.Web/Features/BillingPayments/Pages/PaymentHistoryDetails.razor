@page "/billing-payments/payment-history-details/{EftPaymentSk:int}"
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using UI.EmployerPortal.Razor.SharedComponents.Helpers
@using UI.EmployerPortal.Web.Logging.NavigationSession
@inject INavigationSessionTracker tracker
@inherits UI.EmployerPortal.Web.Auth.EmployerAuthorizedPage

<PageTitle>Payment Details</PageTitle>

<div class="page-wrapper">
    <div class="page-content">

        <h1 class="page-title">Payment Details</h1>
        <hr class="page-divider" />

        @if (_isLoading)
        {
            <p class="loading-text" aria-live="polite" aria-atomic="true">Loading payment details...</p>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <NotificationBanner NotificationType="NotificationType.Alert"
                                MessageStyle="MessageStyle.MultiLine"
                                Messages="@(new List<string> { _loadError })"
                                MessageFieldIds="@(new List<string> { "_" })"
                                Visible="true" />
        }
        else if (_payment is not null)
        {
            @* ── Payment Information ── *@
            <section class="detail-card" aria-labelledby="payment-info-heading">
                <div class="detail-card-header">
                    <h2 id="payment-info-heading" class="detail-card-title">Payment Information</h2>
                    <button type="button"
                            class="detail-collapse-btn"
                            aria-expanded="@_paymentInfoExpanded.ToString().ToLower()"
                            aria-controls="payment-info-body"
                            aria-label="@(_paymentInfoExpanded ? "Collapse Payment Information" : "Expand Payment Information")"
                            @onclick="@(() => tracker.LogNavigationSessionActivity(() => _paymentInfoExpanded = !_paymentInfoExpanded, _paymentInfoExpanded ? "Collapse Payment Information" : "Expand Payment Information" + " Clicked", DateTime.Now))">
                        <span aria-hidden="true">@((MarkupString)(_paymentInfoExpanded ? "&#8963;" : "&#8964;"))</span>
                    </button>
                </div>
                <dl id="payment-info-body"
                     class="detail-grid"
                     aria-labelledby="payment-info-heading"
                     hidden="@(!_paymentInfoExpanded)">
                    <div class="detail-field">
                        <dt class="detail-label">Confirmation Number</dt>
                        <dd class="detail-value">@_payment.ConfirmationNumber</dd>
                    </div>
                    <div class="detail-field">
                        <dt class="detail-label">Transaction Date/Time</dt>
                        <dd class="detail-value">
                            @(_payment.TransactionDateTime.HasValue
                                ? _payment.TransactionDateTime.Value.ToDisplayString("MM/dd/yyyy hh:mm tt ZZZ")
                                : "—")
                        </dd>
                    </div>
                    <div class="detail-field">
                        <dt class="detail-label">Description</dt>
                        <dd class="detail-value">@_paymentDescription</dd>
                    </div>
                    <div class="detail-field">
                        <dt class="detail-label">Payment Amount</dt>
                        <dd class="detail-value">
                            @(_payment.Amount.HasValue ? _payment.Amount.Value.ToString("C") : "—")
                        </dd>
                    </div>
                    <div class="detail-field">
                        <dt class="detail-label">Settlement Date</dt>
                        <dd class="detail-value">
                            @(_payment.SettlementDate.HasValue ? _payment.SettlementDate.Value.ToString("MM/dd/yyyy") : "—")
                        </dd>
                    </div>
                    <div class="detail-field">
                        <dt class="detail-label">Status</dt>
                        <dd class="detail-value">@_payment.Status</dd>
                    </div>
                    <div class="detail-field">
                        <dt class="detail-label">Cancel Date/Time</dt>
                        @if (_payment.CancellationDate.HasValue)
                        {
                            <dd class="detail-value">
                                @_payment.CancellationDate.Value.ToString("MM/dd/yyyy hh:mm tt") CST
                            </dd>
                        }
                    </div>
                </dl>
            </section>

            @* ── Bank Information ── *@
            <section class="detail-card" aria-labelledby="bank-info-heading">
                <div class="detail-card-header">
                    <h2 id="bank-info-heading" class="detail-card-title">Bank Information</h2>
                    <button type="button"
                            class="detail-collapse-btn"
                            aria-expanded="@_bankInfoExpanded.ToString().ToLower()"
                            aria-controls="bank-info-body"
                            aria-label="@(_bankInfoExpanded ? "Collapse Bank Information" : "Expand Bank Information")"
                            @onclick="@(() => tracker.LogNavigationSessionActivity(() => _bankInfoExpanded = !_bankInfoExpanded, _bankInfoExpanded ? "Collapse Bank Information" : "Expand Bank Information" + " Clicked", DateTime.Now))">
                        <span aria-hidden="true">@((MarkupString)(_bankInfoExpanded ? "&#8963;" : "&#8964;"))</span>
                    </button>
                </div>
                <dl id="bank-info-body"
                     class="detail-grid"
                     aria-labelledby="bank-info-heading"
                     hidden="@(!_bankInfoExpanded)">
                    @if (_payment.BankAccount is not null)
                    {
                        <div class="detail-field">
                            <dt class="detail-label">Bank Account Nickname</dt>
                            <dd class="detail-value">@_payment.BankAccount.Nickname</dd>
                        </div>
                        <div class="detail-field">
                            <dt class="detail-label">Bank Name</dt>
                            <dd class="detail-value">@_payment.BankAccount.BankName</dd>
                        </div>
                        <div class="detail-field">
                            <dt class="detail-label">Bank Routing Number</dt>
                            <dd class="detail-value">@_payment.BankAccount.RoutingNumber</dd>
                        </div>
                        <div class="detail-field">
                            <dt class="detail-label">Bank Account Number</dt>
                            <dd class="detail-value">@_payment.BankAccount.MaskedAccountNumber</dd>
                        </div>
                        <div class="detail-field">
                            <dt class="detail-label">Account Type</dt>
                            <dd class="detail-value">@_payment.BankAccount.AccountType</dd>
                        </div>
                    }
                </dl>
            </section>

            @* ── Contact Information ── *@
            <section class="detail-card" aria-labelledby="contact-info-heading">
                <div class="detail-card-header">
                    <h2 id="contact-info-heading" class="detail-card-title">Contact Information</h2>
                    <button type="button"
                            class="detail-collapse-btn"
                            aria-expanded="@_contactInfoExpanded.ToString().ToLower()"
                            aria-controls="contact-info-body"
                            aria-label="@(_contactInfoExpanded ? "Collapse Contact Information" : "Expand Contact Information")"
                            @onclick="@(() => tracker.LogNavigationSessionActivity(() => _contactInfoExpanded = !_contactInfoExpanded, _contactInfoExpanded ? "Collapse Contact Information" : "Expand Contact Information" + " Clicked", DateTime.Now))">
                        <span aria-hidden="true">@((MarkupString)(_contactInfoExpanded ? "&#8963;" : "&#8964;"))</span>
                    </button>
                </div>
                <dl id="contact-info-body"
                     class="detail-grid"
                     aria-labelledby="contact-info-heading"
                     hidden="@(!_contactInfoExpanded)">
                    @if (_payment.ContactInfo is not null)
                    {
                        <div class="detail-field">
                            <dt class="detail-label">Contact Name</dt>
                            <dd class="detail-value">@_payment.ContactInfo.ContactName</dd>
                        </div>
                        <div class="detail-field">
                            <dt class="detail-label">Phone Number</dt>
                            <dd class="detail-value">@_payment.ContactInfo.PhoneNumber</dd>
                        </div>
                        <div class="detail-field">
                            <dt class="detail-label">Email Address</dt>
                            <dd class="detail-value">@_payment.ContactInfo.Email</dd>
                        </div>
                    }
                </dl>
            </section>

            @* ── Payment Activity ── *@
            <section class="detail-card" aria-labelledby="activity-heading">
                <div class="detail-card-header">
                    <h2 id="activity-heading" class="detail-card-title">Payment Activity</h2>
                    <button type="button"
                            class="detail-collapse-btn"
                            aria-expanded="@_activityExpanded.ToString().ToLower()"
                            aria-controls="activity-body"
                            aria-label="@(_activityExpanded ? "Collapse Payment Activity" : "Expand Payment Activity")"
                            @onclick="@(() => tracker.LogNavigationSessionActivity(() => _activityExpanded = !_activityExpanded, _activityExpanded ? "Collapse Payment Activity" : "Expand Payment Activity" + " Clicked", DateTime.Now))">
                        <span aria-hidden="true">@((MarkupString)(_activityExpanded ? "&#8963;" : "&#8964;"))</span>
                    </button>
                </div>
                <div id="activity-body"
                     class="table-container"
                     role="region"
                     aria-labelledby="activity-heading"
                     hidden="@(!_activityExpanded)">
                    @if (_payment.ActivityHistory.Count == 0)
                    {
                        <p class="no-activity-text">No payment activity to display.</p>
                    }
                    else
                    {
                        <table class="activity-table" aria-label="Payment activity history">
                            <caption class="visually-hidden">
                                Column headers with buttons are sortable.
                            </caption>
                            <thead>
                                <tr>
                                    <th scope="col"
                                        class="activity-header-cell col-date @(_activitySortColumn == "date" ? "col-active-sort" : "")"
                                        aria-sort="@GetActivityAriaSort("date")">
                                        <button type="button" class="activity-header-content column-sort-btn" @onclick="@(() => tracker.LogNavigationSessionActivity(() => SortActivity("date"), "Sort By Date/Time Clicked", DateTime.Now))">
                                            <span>Date/Time</span>
                                            <span aria-hidden="true">@GetActivitySortIcon("date")</span>
                                        </button>
                                    </th>
                                    <th scope="col"
                                        class="activity-header-cell col-action @(_activitySortColumn == "action" ? "col-active-sort" : "")"
                                        aria-sort="@GetActivityAriaSort("action")">
                                        <button type="button" class="activity-header-content column-sort-btn" @onclick="@(() => tracker.LogNavigationSessionActivity(() => SortActivity("action"), "Sort By Action Clicked", DateTime.Now))">
                                            <span>Action</span>
                                            <span aria-hidden="true">@GetActivitySortIcon("action")</span>
                                        </button>
                                    </th>
                                    <th scope="col"
                                        class="activity-header-cell col-description @(_activitySortColumn == "description" ? "col-active-sort" : "")"
                                        aria-sort="@GetActivityAriaSort("description")">
                                        <button type="button" class="activity-header-content column-sort-btn" @onclick="@(() => tracker.LogNavigationSessionActivity(() => SortActivity("description"), "Sort By Description Clicked", DateTime.Now))">
                                            <span>Description</span>
                                            <span aria-hidden="true">@GetActivitySortIcon("description")</span>
                                        </button>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in GetSortedActivity())
                                {
                                    <tr>
                                        <td class="activity-data-cell">
                                            @item.Date.ToString("M/d/yyyy")<br />@item.Date.ToString("h:mm tt")
                                        </td>
                                        <td class="activity-data-cell">@item.Action</td>
                                        <td class="activity-data-cell">@item.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>
        }

        <div class="button-bar">
            <Button Variant="Button.ButtonVariant.Secondary"
                    OnClick="@(() => tracker.LogNavigationSessionActivity(HandleBack, "Back Clicked", DateTime.Now))">
                <img src="@Assets["icons/chevron-left.svg"]" alt="" aria-hidden="true" />
                BACK
            </Button>
        </div>

    </div>
</div>
