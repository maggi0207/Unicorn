@using Microsoft.FluentUI.AspNetCore.Components
@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using UI.EmployerPortal.Web.Features.ESP.Models
@using UI.EmployerPortal.Web.Features.ESP.Services

<div class="ach-info-card">
    <div class="ach-info-card-header">
        <h2 id="bank-info-heading" class="ach-info-card-title fw-bold">Bank Information</h2>
        <div class="ach-info-card-header-actions">
            @if (BankAccounts is not null && BankAccounts.Count > 0)
            {
                <button type="button"
                        class="ach-collapse-btn"
                        aria-expanded="@_expanded.ToString().ToLower()"
                        aria-controls="bank-info-body"
                        aria-label="@(_expanded ? "Collapse Bank Information" : "Expand Bank Information")"
                        @onclick="ToggleExpanded">
                    <img src="@Assets["icons/chevron_up.svg"]"
                        class="accordion-caret @(_expanded ? "" : "accordion-caret--collapsed")"
                        width="24" height="24" aria-hidden="true" alt="" />
                </button>
            }
        </div>
    </div>
    <hr class="ach-section-divider" aria-hidden="true" />
    <div id="bank-info-body"
         role="region"
         aria-labelledby="bank-info-heading"
         hidden="@(!_expanded)">
        @if (BankAccounts is not null && BankAccounts.Count > 0)
        {
            @if (!ReadOnly)
            {
                <div class="ach-bank-account-select-group" style="display:grid; grid-template-columns: 1fr auto; gap: 24px; align-items: flex-start; margin-bottom: 16px;">
                    <div style="max-width: 400px;">
                        <OutlinedSelectField Label="Bank Account"
                                             Id="bankAccountSelect"
                                             Value="@_selectedAccountNickname"
                                             ValueChanged="OnAccountChanged"
                                             Options="@BankAccountOptions"
                                             Placeholder="Select Account Type"
                                             DisableEmptyOption="true" />
                    </div>
                    @if (_showEditLink && BankAccount is not null)
                    {
                        <div class="ach-edit-col" style="padding-top: 10px;">
                            <button type="button"
                                    class="ach-edit-link"
                                    aria-label="Edit Bank Information"
                                    @onclick="HandleEditClick">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#003B70" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                                </svg> Edit
                            </button>
                        </div>
                    }
                </div>
            }

            if (_selectedAccount is not null)
            {
                <!-- 2-column detail grid -->
                <div class="ach-bank-grid">
                    <div class="ach-info-field">
                        <span class="ach-info-label">Bank Account Nickname</span>
                        <strong class="ach-info-value">@_selectedAccount.Nickname</strong>
                    </div>
                    <div class="ach-info-field" style="@(ReadOnly && _showEditLink ? "display:grid; grid-template-columns: 1fr auto; align-items:flex-start;" : "")">
                        <div>
                            <span class="ach-info-label">Bank Name</span>
                            <strong class="ach-info-value">@_selectedAccount.BankName</strong>
                        </div>
                        @if (ReadOnly && _showEditLink && BankAccount is not null)
                        {
                            <div class="ach-edit-col">
                                <button type="button"
                                        class="ach-edit-link"
                                        aria-label="Edit Bank Information"
                                        @onclick="HandleEditClick">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#003B70" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                                    </svg> Edit
                                </button>
                            </div>
                        }
                    </div>
                    <div class="ach-info-field">
                        <span class="ach-info-label">Bank Routing Number</span>
                        <strong class="ach-info-value">@_selectedAccount.RoutingNumber</strong>
                    </div>
                    <div class="ach-info-field">
                        <span class="ach-info-label">Bank Account Number</span>
                        <strong class="ach-info-value">@_selectedAccount.MaskedAccountNumber</strong>
                    </div>
                </div>
                <div class="ach-info-field ach-info-field--full">
                    <span class="ach-info-label">Type</span>
                    <strong class="ach-info-value">@_selectedAccount.AccountType</strong>
                </div>
            }
            if (!ReadOnly)
            {
                <a href="esp/manage-bank-accounts?showback=true&action=add"
                       class="ach-add-link"
                       aria-label="Add Bank Account">
                    + Add Account
                </a>
            }
        }
        else if (!ReadOnly)
        {
            <a href="esp/manage-bank-accounts?showback=true&action=add"
                   class="ach-add-link"
                   aria-label="Add Bank Account">
                + Add Account
            </a>
        }
    </div>
</div>

@code {
    [Parameter] public List<SavedBankAccount>? BankAccounts { get; set; }
    [Parameter] public SavedBankAccount? BankAccount { get; set; }
    [Parameter] public EventCallback<SavedBankAccount> SelectedAccountChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool? ShowEditLink { get; set; }
    [Parameter] public int? EftPaymentSkParam { get; set; }
    [Inject] private IESPBankAccountSessionStore SessionStorage { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private bool _showEditLink => ShowEditLink ?? !ReadOnly;
    private bool _expanded = true;

    private SavedBankAccount? _selectedAccount;
    private string? _selectedAccountNickname;

    private List<SelectOption> BankAccountOptions => BankAccounts?.Select(a => new SelectOption
    {
        Value = a.Nickname,
        Text = a.Nickname
    }).ToList() ?? new();

    protected override void OnParametersSet()
    {
        if (_selectedAccount is null)
        {
            _selectedAccount = BankAccount ?? BankAccounts?.FirstOrDefault();
            _selectedAccountNickname = _selectedAccount?.Nickname;
        }
    }

    private void ToggleExpanded() => _expanded = !_expanded;

    private async Task OnAccountChanged(string? nickname)
    {
        _selectedAccountNickname = nickname;
        _selectedAccount = BankAccounts?.FirstOrDefault(a => a.Nickname == nickname);
        if (_selectedAccount is not null)
        {
            await SelectedAccountChanged.InvokeAsync(_selectedAccount);
        }
    }

    private async Task HandleEditClick()
    {
        //eftPaymentSk=9003&action=edit
        await SessionStorage.SetAsync(BankAccount!.BankAccountSk);
        if (EftPaymentSkParam > 0)
        {
            Nav.NavigateTo($"esp/manage-bank-accounts?showback=true&action=edit&eftPaymentSk={EftPaymentSkParam}");
        }
        else
        {
            Nav.NavigateTo("esp/manage-bank-accounts?showback=true&action=edit");
        }
    }
}
