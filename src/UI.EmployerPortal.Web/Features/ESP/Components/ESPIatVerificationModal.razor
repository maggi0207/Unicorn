@using UI.EmployerPortal.Razor.SharedComponents
@using Microsoft.AspNetCore.Components.Web

@if (IsVisible)
{
    <div class="modal-overlay" role="presentation">
        <div class="modal-container"
             role="dialog"
             aria-modal="true"
             aria-labelledby="iat-verification-modal-title"
             aria-describedby="iat-verification-modal-body"
             @onkeydown="HandleKeyDown"
             tabindex="-1"
             @ref="_modalRef">
            <div class="modal-header">
                <h3 id="iat-verification-modal-title" class="modal-title">IAT Bank Account Verification</h3>
                <button class="modal-close" @onclick="OnCancel">
                    <img src="icons/close_x_blue.svg" />
                </button>
            </div>
            <div id="iat-verification-modal-body" class="modal-body">
                <p>
                    You reported the bank account used to make your electronic funds transfer payment
                    is funded by a transfer from a financial institution <strong>outside of the U.S.</strong>
                    If this is correct, select Confirm to continue.
                </p>
                <p>
                    Otherwise, select Cancel and uncheck "The bank account used to make my electronic
                    payment is funded by a transfer from a financial institution outside of the U.S."
                </p>
            </div>
            <div class="modal-footer">
                <Button Variant="Button.ButtonVariant.Secondary"
                        type="button"
                        ShowBorder="false"
                        OnClick="OnCancel">
                    CANCEL
                </Button>
                <Button Variant="Button.ButtonVariant.Secondary"
                        type="button"
                        OnClick="OnConfirm">
                    CONFIRM
                </Button>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public bool IsVisible { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private ElementReference _modalRef;
    private bool _wasVisible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //Move focus into modal on open so screen readers announce it immediately

        if (IsVisible && !_wasVisible)
        {
            _wasVisible = true;
            await _modalRef.FocusAsync();
        }
        else if (!IsVisible && _wasVisible)
        {
            _wasVisible = false;
        }
    }
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        //Escape key dismissal
        if (e.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
    }
}
