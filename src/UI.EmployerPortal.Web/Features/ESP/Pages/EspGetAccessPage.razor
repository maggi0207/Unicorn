@page "/esp/account/get-access"
@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using static UI.EmployerPortal.Razor.SharedComponents.Button

<PageTitle>Get Account Access</PageTitle>
<div class="gak-page-container">
    @* ── Header ── *@
    <div class="account-header">
        <div class="account-details fs-xl">
            <div class="account-info">
                <span class="detail-item account-name">
                    <span class="detail-label">Get Service Provider Access</span>
                </span>
            </div>
        </div>
        <div class="account-sub-details fs-sm">
            <div class="account-sub-info">
                <span class="detail-value">Access the Service Provider Portal.</span>
            </div>
        </div>
    </div>
    <div class="gak-body">
        @if (_successMessage != null)
        {
            <NotificationBanner NotificationType="NotificationType.Confirmation"
                                Message="@_successMessage" />
        }
        @if (_serviceError != null)
        {
            <NotificationBanner NotificationType="NotificationType.Alert"
                                Message="@_serviceError" />
        }
        @* ── Section bar ── *@
        <div class="gak-section-bar">Enter Access Key</div>

        @* ── EditForm wraps body + footer so submit button is inside the form ── *@
        <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <div class="gak-main-body">
                <p class="gak-description">Enter your access key and the associated ESP FEIN.</p>
               
                <OutlinedTextField Label="Access Key"
                                   Id="gak-key"
                                   @bind-Value="_form.AccessKey"
                                   For="@(() => _form.AccessKey)"
                                   Placeholder="Enter Access Key"
                                   Disabled="@_isLoading"
                                   Required="true" />

                <OutlinedTextField Label="FEIN"
                                   Id="gak-fein"
                                   @bind-Value="_form.FEIN"
                                   For="@(() => _form.FEIN)"
                                   Placeholder="Enter FEIN (e.g. 12-3456789)"
                                   InputMode="numeric"
                                   Mask="00-0000000"
                                   Disabled="@_isLoading"
                                   Required="true" />
            </div>

            @* ── Footer ── *@
            <div class="gak-footer">
                <Button Variant="ButtonVariant.Secondary"
                        Disabled="@_isLoading"
                        Onclick="HandleBack">
                    <img src="@(Assets["icons/chevron-left.svg"])" alt="" />
                    BACK
                </Button>

                <Button Type="submit"
                        Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
  
                    }
                    <span class="esp-btn-content">
                        CONTINUE
                        <img src="@(Assets["icons/button-next.svg"])" alt="" aria-hidden="true" class="esp-btn-icon" />
                    </span>
                </Button>
            </div>
        </EditForm>
    </div>
</div>
