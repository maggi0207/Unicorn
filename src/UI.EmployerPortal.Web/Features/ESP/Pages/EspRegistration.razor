@page "/esp/account/register"
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using UI.EmployerPortal.Web.Features.ESP.Components
@using static UI.EmployerPortal.Razor.SharedComponents.Button
@inherits UI.EmployerPortal.Web.Auth.EmployerAuthorizedPage
<PageTitle>Employer Service Provider Registration</PageTitle>
<div class="page-content esp-registration-page">
    @if (_isLoading)
    {
        <LoadingSpinner Message="Submitting..." />
    }
    else if (_pageState == PageState.Submitted)
    {
        <div role="alert">
            <NotificationBanner NotificationType="NotificationType.Confirmation"
                Message="You have successfully completed the Employer Service Provider registration" />
        </div>
    }
    else
    {
        @if (_ruleViolationMessages.Count > 0)
        {
            <NotificationBanner NotificationType="NotificationType.Alert"
                                    MessageStyle="MessageStyle.MultiLine"
                                    Messages="_ruleViolationMessages" />
        }

        @if (_pageState == PageState.Entry)
        {
            <h1 id="@EditPageId" class="page-title" tabindex="-1">Employer Service Provider Registration</h1>
            <EspRegistrationEntry Model="_model" @ref="_entryRef" />

            <div class="esp-button-bar esp-button-bar--end">
                <Button Text="CONTINUE"
                        Variant="ButtonVariant.Primary"
                        OnClick="HandleContinue"
                        AriaLabel="Continue to review">
                    <span class="esp-btn-content">
                        CONTINUE
                        <img src="@Assets["icons/button-next.svg"]" alt="" aria-hidden="true" class="esp-btn-icon" />
                    </span>
                </Button>
            </div>
        }
        else if (_pageState == PageState.Review)
        {
            <h1 id="@ReviewPageId" class="page-title" tabindex="-1">Review Employer Service Provider Registration</h1>
            <p class="page-subtitle">Carefully review all the information and Submit to save after updates.</p>

            <div class="esp-edit-bar">
                <Button Variant="ButtonVariant.Secondary"
                        OnClick="HandleEdit"
                        AriaLabel="Edit registration details">
                    <span class="esp-btn-content">
                        <img src="@Assets["icons/edit-icon.svg"]" alt="" aria-hidden="true" class="esp-btn-icon" />
                        EDIT
                    </span>
                </Button>
            </div>

            <EspRegistrationReview Model="_model" />

            <div class="esp-button-bar esp-button-bar--split">
                <Button Text="CANCEL"
                        Variant="ButtonVariant.Secondary"
                        OnClick="HandleCancel"
                        AriaLabel="Cancel registration" />
                <Button Text="SUBMIT"
                        Variant="ButtonVariant.Primary"
                        OnClick="HandleSubmit"
                        AriaLabel="Submit registration" />
            </div>
        }
    }
</div>
