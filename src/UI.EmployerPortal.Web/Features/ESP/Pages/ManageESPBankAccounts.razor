@page "/esp/manage-bank-accounts"
@using UI.EmployerPortal.Web.Features.ESP.Components
@using UI.EmployerPortal.Web.Features.ESP.Models
@using UI.EmployerPortal.Razor.SharedComponents
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners

@inherits UI.EmployerPortal.Web.Auth.EmployerAuthorizedPage

<PageTitle>Manage Bank Accounts</PageTitle>

@if (_pageState == BankAccountPageState.AddForm)
{
    <ESPBankInformationForm OnSaved="(ba) => HandleSaved(ba)"
                         OnBack="HandleBackToList"
                         OnCancel="HandleBackToList"
                         Showback="_canGoBack"/>
}
else if (_pageState == BankAccountPageState.EditForm)
{
    <ESPBankInformationForm BankAccountSk="_editAccountSk"
                         OnSaved="HandleSaved"
                         OnBack="HandleBackToList"
                         OnCancel="HandleBackToList"
                         Showback="_canGoBack" />
}
else if (_pageState == BankAccountPageState.Confirmation)
{
    <ESPBankAccountSavedConfirmation SavedAccount="_savedAccount"
                                  OnBack="HandleBackToList"
                                  OnContinue="HandleBackToList"
                                  OnViewAccounts="HandleBackToList" />
}
else
{
    <div class="page-wrapper">
        <div class="list-content">
            <h1 class="page-title">Manage Bank Accounts</h1>
            <hr class="page-divider" />
            <section aria-label="Accounts">
                <div aria-live="polite">
                    @if (_deleteSuccessMessage)
                    {
                        <NotificationBanner NotificationType="NotificationType.Confirmation"
                                            Title="Bank account deleted successfully"
                                            Visible="true"
                                            DismissButton="true"/>
                    }
                </div>
                <h2 class="section-title">Accounts</h2>
                <hr class="section-divider" />

                @if (_isLoading)
                {
                    <LoadingSpinner Message="Loading accounts, Please wait..."/>
                }
                else if (IsPendingPaymentError)
                {
                    <NotificationBanner NotificationType="NotificationType.Alert"
                                        Message="@_loadError"
                                        Visible="true" />

                    <div class="action-row" role="group" aria-label="Page actions">
                        <Button Variant="Button.ButtonVariant.Secondary"
                                Size="Button.ButtonSize.Medium"
                                AriaLabel="Go back to bank accounts"
                                OnClick="HandleClearError">
                            &lt; BACK
                        </Button>
                        <Button Variant="Button.ButtonVariant.Primary"
                                Size="Button.ButtonSize.Medium"
                                AriaLabel="Go to Payment History"
                                OnClick="HandleGoToPaymentHistory">
                            PAYMENT HISTORY
                        </Button>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_loadError))
                {
                    <NotificationBanner NotificationType="NotificationType.Alert"
                                        Message="@_loadError"
                                        Visible="true" />
                }
                else
                {
                    <p class="page-subtitle">Select an account to edit</p>
                    <div class="table-container">
                        <table class="accounts-table"
                            style="width: 100%"
                            aria-label="Bank accounts">
                            <caption class="visually-hidden">
                                View bank accounts (column headers with buttons are sortable).
                            </caption>
                            <thead>
                                <tr class="header-row">
                                    <th scope="col" class="header-cell" aria-sort="@GetAriaSort("nickname")">
                                        <div class="header-content header-content-left">
                                            <button type="button" class="header-sort-button" @onclick="@(() => Sort("nickname"))">
                                                <span class="header-label fw-bold">Account Nickname</span>
                                                <span aria-hidden="true">@GetSortIcon("nickname")</span>
                                            </button>
                                        </div>
                                    </th>
                                    <th scope="col" class="header-cell" aria-sort="@GetAriaSort("bankName")">
                                        <div class="header-content header-content-left">
                                            <button type="button" class="header-sort-button" @onclick="@(() => Sort("bankName"))">
                                                <span class="header-label fw-bold">Bank Name</span>
                                                <span aria-hidden="true">@GetSortIcon("bankName")</span>
                                            </button>
                                        </div>
                                    </th>
                                    <th scope="col" class="header-cell" aria-sort="@GetAriaSort("accountType")">
                                        <div class="header-content header-content-left">
                                            <button type="button" class="header-sort-button" @onclick="@(() => Sort("accountType"))">
                                                <span class="header-label fw-bold">Type</span>
                                                <span aria-hidden="true">@GetSortIcon("accountType")</span>
                                            </button>
                                        </div>
                                    </th>
                                    <th scope="col" class="header-cell" aria-sort="@GetAriaSort("accountNumber")">
                                        <div class="header-content header-content-left">
                                            <button type="button" class="header-sort-button" @onclick="@(() => Sort("accountNumber"))">
                                                <span class="header-label fw-bold">Account Number</span>
                                                <span aria-hidden="true">@GetSortIcon("accountNumber")</span>
                                            </button>
                                        </div>
                                    </th>
                                    <th scope="col" class="header-cell" aria-sort="@GetAriaSort("routingNumber")">
                                        <div class="header-content header-content-left">
                                            <button type="button" class="header-sort-button" @onclick="@(() => Sort("routingNumber"))">
                                                <span class="header-label fw-bold">Routing Number</span>
                                                <span aria-hidden="true">@GetSortIcon("routingNumber")</span>
                                            </button>
                                        </div>
                                    </th>
                                    <th scope="col" class="header-cell header-cell-static" >
                                        <div class="header-content header-content-left">
                                            <span class="header-label fw-bold">Remove</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_accounts.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="no-accounts-message">No bank accounts on file.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var account in GetSortedAccounts())
                                    {
                                        <tr class="data-row">
                                            <td class="fw-normal">
                                                <button type="button"
                                                        class="account-link"
                                                        aria-label="View or edit @account.Nickname"
                                                        @onclick="() => HandleEditAccount(account.BankAccountSk)">
                                                    @account.Nickname
                                                </button>
                                            </td>
                                            <td class="fw-normal">@account.BankName</td>
                                            <td class="fw-normal">@account.AccountType</td>
                                            <td class="fw-normal">@account.MaskedAccountNumber</td>
                                            <td class="fw-normal">@account.RoutingNumber</td>
                                            <td>
                                                <button type="button"
                                                        class="delete-btn"
                                                        aria-label="Remove @account.Nickname"
                                                        @onclick="() => OpenRemoveModal(account)">
                                                    <img src="@Assets["icons/delete.svg"]" alt="" aria-hidden="true" />
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="add-account-row">
                        <button type="button"
                                class="add-account-link"
                                aria-label="Add a bank account"
                                @onclick="HandleAddAccount">
                            + Add Account
                        </button>
                    </div>
                }
            </section>
        </div>
    </div>

    <RemoveESPBankAccountModal IsVisible="_showRemoveModal"
                     OnCancel="CancelRemove"
                     OnConfirm="ConfirmRemove" />
}
