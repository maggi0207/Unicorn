@using UI.EmployerPortal.Razor.SharedComponents
@using UI.EmployerPortal.Razor.SharedComponents.Helpers
@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms

@if (IsVisible)
{
    <div class="modal-overlay" role="presentation">
        <div class="modal-container"
             role="dialog"
             aria-modal="true"
             aria-labelledby="nonprofit-modal-title"
             aria-describedby="nonprofit-modal-body"
             @onkeydown="HandleKeyDown"
             tabindex="-1"
             @ref="_modalRef">
            <div class="modal-header">
                <h3 id="nonprofit-modal-title" class="modal-title">Inconsistent Non-Profit Designation</h3>
                <button class="modal-close" @onclick="OnStayOnStep6">
                    <img src="icons/close_x_blue.svg" />
                </button>
            </div>
            <div id="nonprofit-modal-body" class="modal-body">
                <p>
                    In step 1, you reported that you are not a non-profit organization as described in
                    s.501(c)(3) of the IRS code. You must take one of these actions.
                </p>
                <EditForm Model="_formModel">
                    <RadioGroup TValue="ModalOption?"
                                LabelledById="nonprofit-modal-body"
                                Value="_formModel.SelectedOption"
                                ValueChanged="@(val => _formModel.SelectedOption = val ?? ModalOption.ReturnToStep1)"
                                ValueExpression="() => _formModel.SelectedOption"
                                Options="@ModalOptions" />
                </EditForm>
            </div>
            <div class="modal-footer">
                <Button Variant="Button.ButtonVariant.Primary"
                        type="button"
                        OnClick="HandleContinue">
                    CONTINUE
                </Button>
            </div>
        </div>
    </div>
}
