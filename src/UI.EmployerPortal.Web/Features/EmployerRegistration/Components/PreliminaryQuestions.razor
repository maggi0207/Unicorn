@using UI.EmployerPortal.Razor.SharedComponents.Address;
@using UI.EmployerPortal.Razor.SharedComponents.Inputs;
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners;
@using UI.EmployerPortal.Web.Features.EmployerRegistration.Models;
@using UI.EmployerPortal.Web.Features.Shared.Extensions;
@using UI.EmployerPortal.Web.Features.Shared.FileUpload.Components;
@using UI.EmployerPortal.Web.Features.Shared.FileUpload.Models;
@inject NavigationManager Nav;

<PageTitle>Preliminary Questions</PageTitle>

<div class="page_wrapper">
    <div class="bi-page-content">
        <h2 class="page-title">Preliminary Questions</h2>

        <!-- Validation Error Summary -->
        @if (_formSubmitted && ValidationErrors.Any())
        {
            <NotificationBanner NotificationType="NotificationType.Alert"
                                MessageStyle="MessageStyle.MultiLine"
                                Messages="ValidationErrors"
                                MessageFieldIds="ValidationFieldIds"
                                DismissButton="false">
            </NotificationBanner>
        }
        <p class="page-subtitle">All fields are required unless noted</p>

        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <!-- FEIN -->
            <FEINField Label="FEIN"
                       Id="FEIN"
                       @bind-Value="Model.FEIN"
                       For="() => Model.FEIN"
                       OnBlur="@(() => _editContext.NotifyFieldChanged(_editContext.Field(nameof(Model.FEIN))))" />

            <br />

            <!-- UI Account Number -->
            <!--Use Mask shared component at line 23 as reference in all your pages whereever needed-->
            <OutlinedTextField Label="Employer UI Account Number (optional)"
                               Id="UIAccountNumber"
                               InputMode="numeric"
                               @bind-Value="Model.UIAccountNumber"
                               For="() => Model.UIAccountNumber"
                               Mask="000000-000-0"
                               FormatText="Format: 999999-999-9" />
            <br />

            <!-- Question 1 -->
            <p id="IsNonProfitOrg">Are you a non-profit organization as described in s.501(c)(3) of the IRS code?</p>
            <FieldError For="@(() => Model.IsNonProfitOrg)"
                        Visible="@_formSubmitted" />
            <RadioGroup TValue="bool?"
                        Value="Model.IsNonProfitOrg"
                        LabelledById="IsNonProfitOrg"
                        ValueChanged="OnIsNonProfitOrgChanged"
                        ValueExpression="() => Model.IsNonProfitOrg"
                        Options="@YesNoRadioOptions" />

            @if (Show501c3SubTree)
            {
                <!-- 501(c)(3) Sub-Tree (shown when 501c3 category is selected above) -->
                <p data-questionid="1.1" id="data-questionid1">Do you have a 501(c)(3) ruling from the IRS?</p>
                <FieldError For="@(() => Model.HasRulingFrom501c3IRS)"
                            Visible="@_formSubmitted" />
                <RadioGroup TValue="bool?"
                            LabelledById="data-questionid1"
                            Value="Model.HasRulingFrom501c3IRS"
                            ValueChanged="OnHasRulingFrom501c3IRSChanged"
                            ValueExpression="() => Model.HasRulingFrom501c3IRS"
                            Options="@YesNoRadioOptions" />
                <br />

                @if (ShowRulingUpload)
                {
                    <!-- Q1.1 Yes: has ruling -->
                    <p data-questionid="1.1.1">Please upload a copy of your 501(c)(3) ruling from the IRS.</p>

                    <FileUpload2 Title="501(c)(3) Ruling from IRS"
                                 OnFileUpload="@ReceiveRulingDoc"
                                 OnFileRemoved="@RemoveRulingDoc"
                                 AllowMultiple="false"
                                 FileType="FileAcceptableType.Registration"
                                 FolderPath="@UploadFolderPath"
                                 SaveOnUpload="true"
                                 FileName="@(Model.RulingDocFilename?.ToDisplayFileName())"
                                 FilePath="@Model.RulingDocFilename" />

                    <CheckboxInput Id="chk-supply-docs-ruling"
                                   Label="I will supply required documentation at a later date."
                                   Value="@Model.WillSupplyDocumentationLater"
                                   ValueChanged="OnWillSupplyDocumentationLaterChanged"
                                   Disabled="@RulingDocUploaded" />
                    <FieldError For="@(() => Model.WillSupplyDocumentationLater)" Visible="@_formSubmitted" />
                    <br />
                }

                @if (ShowHasAppliedQuestion)
                {
                    <!-- Q1.1 No: no ruling — ask if applied -->
                    <p data-questionid="1.1.2" id="data-questionid2">Have you applied for 501(c)(3) status with the IRS?</p>
                    <FieldError For="@(() => Model.HasAppliedFor501c3WithIRS)"
                                Visible="@_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="data-questionid2"
                                Value="Model.HasAppliedFor501c3WithIRS"
                                ValueChanged="OnHasAppliedFor501c3WithIRSChanged"
                                ValueExpression="() => Model.HasAppliedFor501c3WithIRS"
                                Options="@YesNoRadioOptions" />
                    <br />

                    @if (ShowAppliedUpload)
                    {
                        <!-- Q1.1.2 Yes: applied -->
                        <p data-questionid="1.1.2.1">Please upload your articles of incorporation and the application acceptance letter from the IRS.</p>
                        <FileUpload2 Title="Articles of Incorporation"
                                     OnFileUpload="@ReceiveArticlesDoc"
                                     OnFileRemoved="@RemoveArticlesDoc"
                                     AllowMultiple="false"
                                     FileType="FileAcceptableType.Registration"
                                     FolderPath="@UploadFolderPath"
                                     SaveOnUpload="true"
                                     FileName="@(Model.ArticlesOfIncorporationFilename?.ToDisplayFileName())"
                                     FilePath="@Model.ArticlesOfIncorporationFilename" />

                        <CheckboxInput Id="chk-supply-docs-articles"
                                       Label="I will supply required documentation at a later date."
                                       Value="@Model.WillSupplyArticlesLater"
                                       ValueChanged="OnWillSupplyArticlesLaterChanged"
                                       Disabled="@ArticlesDocUploaded" />

                        <FieldError For="@(() => Model.WillSupplyArticlesLater)" Visible="@_formSubmitted" />

                        <FileUpload2 Title="IRS Acceptance Letter"
                                     OnFileUpload="@ReceiveIrsAcceptanceDoc"
                                     OnFileRemoved="@RemoveIrsAcceptanceDoc"
                                     AllowMultiple="false"
                                     FileType="FileAcceptableType.Registration"
                                     FolderPath="@UploadFolderPath"
                                     SaveOnUpload="true"
                                     FileName="@(Model.IRSAcceptanceLetterFilename?.ToDisplayFileName())"
                                     FilePath="@Model.IRSAcceptanceLetterFilename" />

                        <CheckboxInput Id="chk-supply-docs-irs"
                                       Label="I will supply required documentation at a later date."
                                       Value="@Model.WillSupplyIrsAcceptanceLater"
                                       ValueChanged="OnWillSupplyIrsAcceptanceLaterChanged"
                                       Disabled="@IrsAcceptanceDocUploaded" />
                        <FieldError For="@(() => Model.WillSupplyIrsAcceptanceLater)" Visible="@_formSubmitted" />
                        <br />
                    }

                    @if (ShowNotAppliedText)
                    {
                        <!-- Q1.1.2 No: not applied -->
                        <p data-questionid="1.1.2.2">
                            You have indicated that you are a 501(c)(3) employer but have not yet applied for that
                            designation with the IRS. We can only treat you as a 501(c)(3) entity if we have a copy
                            of your 501(c)(3) ruling on file. Please upload a copy of your articles of incorporation.
                            Once your 501(c)(3) application has been accepted by the IRS, please submit a copy of
                            your application acceptance letter.
                        </p>
                        <FileUpload2 Title="Articles of Incorporation"
                                     OnFileUpload="@ReceiveArticlesDoc"
                                     OnFileRemoved="@RemoveArticlesDoc"
                                     AllowMultiple="false"
                                     FileType="FileAcceptableType.Registration"
                                     FolderPath="@UploadFolderPath"
                                     SaveOnUpload="true"
                                     FileName="@(Model.ArticlesOfIncorporationFilename?.ToDisplayFileName())"
                                     FilePath="@Model.ArticlesOfIncorporationFilename" />

                        <CheckboxInput Id="chk-supply-docs-articles"
                                       Label="I will supply required documentation at a later date."
                                       Value="@Model.WillSupplyArticlesLater"
                                       ValueChanged="OnWillSupplyArticlesLaterChanged"
                                       Disabled="@ArticlesDocUploaded" />

                        <FieldError For="@(() => Model.WillSupplyArticlesLater)" Visible="@_formSubmitted" />
                        <br />
                    }
                }
            }


            <!-- Question 2 -->
            <p id="AcquiredExistingBusiness">Have you acquired through sale, reorganization or other means an existing business operation in Wisconsin?</p>
            <FieldError For="@(() => Model.AcquiredExistingBusiness)"
                        Visible="@_formSubmitted" />
            <RadioGroup TValue="bool?"
                        LabelledById="AcquiredExistingBusiness"
                        Value="Model.AcquiredExistingBusiness"
                        ValueChanged="OnAcquiredExistingBusinessChanged"
                        ValueExpression="() => Model.AcquiredExistingBusiness"
                        Options="@YesNoRadioOptions" />
            <br />

            @if (VisibilityQuestion_2_1)
            {
                <!-- Question 2.1 -->
                <p id="KnowAcquiredBusinessAccountNumber" data-questionid="2.1">Do you know the Account Number of the acquired business?</p>
                <FieldError For="@(() => Model.KnowAcquiredBusinessAccountNumber)"
                            Visible="@_formSubmitted" />
                <RadioGroup TValue="bool?"
                            LabelledById="KnowAcquiredBusinessAccountNumber"
                            Value="Model.KnowAcquiredBusinessAccountNumber"
                            ValueChanged="OnKnowAcquiredBusinessAccountNumberChanged"
                            ValueExpression="() => Model.KnowAcquiredBusinessAccountNumber"
                            Options="@YesNoRadioOptions" />
                <br />

                @if (VisibilityQuestion_2_1_1)
                {
                    <!-- Question 2.1.1 (Question 2.1 Yes) -->
                    <span data-questionid="2.1.1"></span>
                    <OutlinedTextField Label="Acquired business Employer UI Account Number"
                                       Id="AcquiredBusinessAccountNumber"
                                       @bind-Value="Model.AcquiredBusinessAccountNumber"
                                       For="() => Model.AcquiredBusinessAccountNumber"
                                       Mask="000000-000-0"
                                       Placeholder="999999-999-9" />
                    <br />
                }
                else if (VisibilityQuestion_2_1_2)
                {
                    <!-- Question  2.1.2 (Question 2.1 No) -->
                    <span data-questionid="2.1.2"></span>
                    <OutlinedTextField Label="Name of the acquired business"
                                       Id="AcquiredBusinessName"
                                       @bind-Value="Model.AcquiredBusinessName"
                                       For="() => Model.AcquiredBusinessName"
                                       Visible="@IsVisible(()=>Model.AcquiredBusinessName)"
                                       MaxLength="128" />
                    <br />

                    <AddressField Legend="Current Address of Acquired Business"
                                  Address="Model.AcquiredBusinessAddress"
                                  Visible="true"
                                  ErrorVisibleForField="(_) => _formSubmitted" />
                    <br />
                }
            }

            @if (VisibilityQuestion_3)
            {
                <!-- Question 3 -->
                <p id="HavePaidEmployeesForWorkInWisconsin" data-questionid="3">Have you paid employees for work performed in Wisconsin?<br /><span class="fw-bold">Do not include wages that have not yet been paid out, or wages reportable to a state other than Wisconsin.</span></p>
                <FieldError For="@(() => Model.HavePaidEmployeesForWorkInWisconsin)"
                            Visible="@_formSubmitted" />
                <RadioGroup TValue="bool?"
                            LabelledById="HavePaidEmployeesForWorkInWisconsin"
                            Value="Model.HavePaidEmployeesForWorkInWisconsin"
                            ValueChanged="OnHavePaidEmployeesForWorkInWisconsinChanged"
                            ValueExpression="() => Model.HavePaidEmployeesForWorkInWisconsin"
                            Options="@YesNoRadioOptions" />
                <br />


                @if (VisibilityQuestion_3_1)
                {
                    <!-- Question 3.1 (Question 3 Yes) -->
                    <p Id="HaveEmployeesCurrentlyWorkingInWisconsin" data-questionid="3.1">Do you still have paid employees working in Wisconsin?</p>
                    <FieldError For="@(() => Model.HaveEmployeesCurrentlyWorkingInWisconsin)"
                                Visible="@_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="HaveEmployeesCurrentlyWorkingInWisconsin"
                                Value="Model.HaveEmployeesCurrentlyWorkingInWisconsin"
                                ValueChanged="OnHaveEmployeesCurrentlyWorkingInWisconsinChanged"
                                ValueExpression="() => Model.HaveEmployeesCurrentlyWorkingInWisconsin"
                                Options="@YesNoRadioOptions" />
                    <br />
                    @if (VisibilityCheckbox_InfoAccurate)
                    {
                        <div class="form-check">
                            <input type="checkbox"
                                   id="chk-info-accurate"
                                   class="form-check-input @(_formSubmitted && !Model.InformationIsAccurate ? "invalid" : "")"
                                   @bind="Model.InformationIsAccurate"
                                   @bind:after="OnInformationIsAccurateChanged" />
                            <label class="form-check-label fw-bold" for="chk-info-accurate">
                                The information provided is true and accurate to the best of my knowledge.
                            </label>
                        </div>
                        <FieldError For="@(() => (object)Model.InformationIsAccurate)" Visible="@_formSubmitted" />
                        <br />
                    }
                }
                @if (VisibilityQuestion_3_2)
                {
                    <!-- Question 3.2 (Question 3 No) -->
                    <p id="ExpectFuturePayroll" data-questionid="3.2">Do you expect to pay wages for work performed in Wisconsin in the future?</p>
                    <FieldError For="@(() => Model.ExpectFuturePayroll)"
                                Visible="@_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="ExpectFuturePayroll"
                                Value="Model.ExpectFuturePayroll"
                                ValueChanged="OnExpectFuturePayrollChanged"
                                ValueExpression="() => Model.ExpectFuturePayroll"
                                Options="@YesNoRadioOptions" />
                    <br />

                    <!-- Question 3.2.1 (Question 3.2 Yes) -->
                    @if (VisibilityQuestion_3_2_1)
                    {
                        <span data-questionid="3.2.1"></span>
                        <OutlinedSelectField Label="When?"
                                             Id="ExpectedFuturePayrollPeriod"
                                             @bind-Value="ExpectedFuturePayrollPeriodAsString"
                                             Options="FuturePayPeriodOptions"
                                             For="() => ExpectedFuturePayrollPeriodAsString" />
                        <FieldError For="@(() => Model.ExpectedFuturePayrollPeriod)"
                                    Visible="@_formSubmitted" />
                        <br />
                    }
                }
            }
            @if (VisibilityQuestion_4)
            {
                <!-- Question 3.1.2 (Question 3.1 No) -->
                <span data-questionid="3.1.2"></span>
                <ValidatedDateInput Id="LastEmploymentDate"
                                    Label="Last Date You Had Employees"
                                    Value="@LastEmploymentDateAsDateTime"
                                    ValueChanged="@(v => OnLastEmploymentDateChanged(v))"
                                    Min="@LastEmploymentDateMin"
                                    Max="@LastEmploymentDateMax"
                                    Width="350"
                                    IsRequired="true"
                                    HasError="@LastEmploymentDateHasError"
                                    ErrorMessage="@LastEmploymentDateError"
                                    Visible="@_formSubmitted"
                                    OnBlur="@(() => NotifyDateFieldChanged(nameof(Model.LastEmploymentDate)))"
                                    FocusKey="response:3025" />
                <br />
                <ValidatedDateInput Id="LastPayrollDate"
                                    Label="Date of Last Payroll"
                                    Value="@LastPayrollDateAsDateTime"
                                    ValueChanged="@(v => OnLastPayrollDateChanged(v))"
                                    Min="@LastEmploymentDateMin"
                                    Max="@LastEmploymentDateMax"
                                    Width="350"
                                    IsRequired="true"
                                    HasError="@LastPayrollDateHasError"
                                    ErrorMessage="@LastPayrollDateError"
                                    Visible="@_formSubmitted"
                                    OnBlur="@(() => NotifyDateFieldChanged(nameof(Model.LastPayrollDate)))" />
                <br />
                <div class="no-employee-section">
                    <p id="SelectedNoEmployeeReason" class="section-title">
                        Select the reason you no longer have paid employees working in Wisconsin.
                    </p>
                    <FieldError For="@(() => Model.SelectedNoEmployeeReason)"
                                Visible="@_formSubmitted" />
                    <RadioGroup TValue="NoEmployeeReason?"
                                LabelledById="SelectedNoEmployeeReason"
                                Value="Model.SelectedNoEmployeeReason"
                                ValueChanged="OnNoEmployeReasonChanged"
                                ValueExpression="() => Model.SelectedNoEmployeeReason"
                                Options="@NoEmployeReasonOptions" />



                    @if (Model.SelectedNoEmployeeReason == NoEmployeeReason.LeasingFromPEO)
                    {
                        <div class="peo-container">
                            <div class="field-wrapper peo-name">
                                <OutlinedTextField Label="Name of the PEO"
                                                   Id="PEOName"
                                                   @bind-Value="Model.PEOName"
                                                   For="() => Model.PEOName"
                                                   Visible="@IsVisible(()=>Model.PEOName)" />
                            </div>
                            <div class="peo-row">
                                <div class="peo-ui">
                                    <OutlinedTextField Label="UI Account Number of the PEO"
                                                       @bind-Value="Model.PEOUIAccountNumber"
                                                       @bind-Value:after="() => Model.PEOFEIN = string.Empty"
                                                       InputMode="numeric"
                                                       Id="PEOUIAccountNumber"
                                                       For="() => Model.PEOUIAccountNumber"
                                                       Mask="000000-000-0"
                                                       Placeholder="999999-999-9" />
                                </div>

                                <span class="or-text">OR</span>

                                <div class="peo-fein">
                                    <FEINField Label="FEIN of the PEO"
                                               Id="PEOFEIN"
                                               @bind-Value="Model.PEOFEIN"
                                               @bind-Value:after="() => Model.PEOUIAccountNumber = string.Empty"
                                               For="() => Model.PEOFEIN"
                                               Placeholder="99-9999999"
                                               OnBlur="@(() => _editContext.NotifyFieldChanged(_editContext.Field(nameof(Model.PEOFEIN))))" />
                                </div>
                            </div>
                            <div class="field-wrapper peo-date">
                                <ValidatedDateInput Id="LeasingStartDate"
                                                    Label="Start Date of Employee Leasing Agreement"
                                                    Value="@LeasingStartDateAsDateTime"
                                                    ValueChanged="@(v => OnLeasingStartDateChanged(v))"
                                                    Min="@LastEmploymentDateMin"
                                                    Max="@LeasingStartDateMax"
                                                    IsRequired="true"
                                                    HasError="@LeasingStartDateHasError"
                                                    ErrorMessage="@LeasingStartDateError"
                                                    Visible="@_formSubmitted"
                                                    OnBlur="@(() => NotifyDateFieldChanged(nameof(Model.LeasingStartDate)))" />
                            </div>
                        </div>
                    }
                    @if (Model.SelectedNoEmployeeReason == NoEmployeeReason.BusiessWithoutEmployees)
                    {
                        <div class="no-employee-reason-wrapper">
                            <label for="NoEmployeeExplanation">
                                Why is the business continuing without employees?
                            </label>
                            <ValidatedTextArea Width="750"
                                               Id="NoEmployeeExplanation"
                                               @bind-Value="Model.NoEmployeeExplanation"
                                               MaxLength="500" />
                            <FieldError For="@(() => Model.NoEmployeeExplanation)"
                                        Visible="@_formSubmitted" />
                        </div>
                    }

                    @if (Model.SelectedNoEmployeeReason == NoEmployeeReason.FiscalAgent)
                    {
                        <div class="fiscal-container">
                            <!-- Row: Fiscal Agent Name (half width) -->
                            <div class="fiscal-row">
                                <div class="field-wrapper fiscal-half">
                                    <OutlinedTextField Label="Fiscal Agent Name"
                                                       Id="FiscalAgentName"
                                                       @bind-Value="Model.FiscalAgentName"
                                                       For="() => Model.FiscalAgentName"
                                                       Visible="@IsVisible(()=>Model.FiscalAgentName)" />
                                </div>
                            </div>
                            <!-- Full width: UI Account Number -->
                            <div class="field-wrapper fiscal-full">
                                <OutlinedTextField Label="Fiscal Agent UI Account Number"
                                                   Id="FiscalAgentUIAccountNumber"
                                                   @bind-Value="Model.FiscalAgentUIAccountNumber"
                                                   For="() => Model.FiscalAgentUIAccountNumber"
                                                   Mask="000000-000-0"
                                                   Placeholder="999999-999-9" />
                            </div>
                        </div>
                    }
                    @if (Model.SelectedNoEmployeeReason == NoEmployeeReason.Other)
                    {
                        <div class="field-wrapper provide-reason">
                            <OutlinedTextField Label="Please Explain"
                                               Id="OtherReason"
                                               @bind-Value="Model.OtherReason"
                                               For="() => Model.OtherReason"
                                               Visible="@IsVisible(()=>Model.OtherReason)" />
                        </div>
                    }
                </div>
            }
        </EditForm>
    </div>
</div>
