@page "/employer-registration/UISubjectivity";

@using UI.EmployerPortal.Razor.SharedComponents.Address
@using UI.EmployerPortal.Razor.SharedComponents.Helpers
@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using UI.EmployerPortal.Razor.SharedComponents.TextBoxes
@using UI.EmployerPortal.Web.Features.EmployerRegistration.Components;
@using UI.EmployerPortal.Web.Features.EmployerRegistration.Models
@using UI.EmployerPortal.Web.Features.Shared.Registrations.Models;
@using UI.EmployerPortal.Razor.SharedComponents.Validation
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using System.Linq.Expressions
@inject EmployerRegistrationInfo RegistrationInfo;
@inject NavigationManager Nav;

<PageTitle>Unemployment Insurance Subjectivity</PageTitle>

<div class="page_wrapper">
    <div class="ui-page-content">
        <!-- Validation Error Summary -->
        @if (_formSubmitted && ValidationErrors.Any())
        {
            <NotificationBanner NotificationType="NotificationType.Alert"
                                MessageStyle="MessageStyle.MultiLine"
                                Messages="ValidationErrors"
                                MessageFieldIds="ValidationFieldIds"
                                DismissButton="false">
            </NotificationBanner>
            <br />
            <br />
        }
        <h1 class="page-title">Unemployment Insurance Subjectivity</h1>
        <p class="page-subtitle">
            These answers will help us determine whether your business is covered under Wisconsin's Unemployment Insurance Law. All fields are required unless noted.
        </p>
        <EditForm EditContext="_subjectivityContext">
           <DataAnnotationsValidator />
            <p class="page-subtitle" id="BusinessCategory" tabindex="-1">
                Select your business category. <strong>To be considered a non-profit organization by the State of Wisconsin, you must have received a 501(c)(3) determination from the IRS.</strong>
            </p>

            <div id="section_1" class="ui-radio-section">
                @switch (_scenario)
                {
                    case BusinessCategoryScenario.LockedNonProfit501c3:
                        <!-- Step 1 = Yes: NonProfit_501c3 pre-selected (greyed), Commercial + NonProfit_Other disabled -->
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled checked id="bc-nonprofit-501c3" />
                            <label for="bc-nonprofit-501c3" class="ui-radio-locked-label">Non-Profit with 501(c)(3) Ruling from IRS</label>
                        </div>
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled id="bc-commercial-disabled" />
                            <label for="bc-commercial-disabled" class="ui-radio-locked-label">Commercial</label>
                        </div>
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled id="bc-nonprofit-other-disabled" />
                            <label for="bc-nonprofit-other-disabled" class="ui-radio-locked-label">Non-Profit (other)</label>
                        </div>
                        break;

                    case BusinessCategoryScenario.LockedAgricultural:
                        <!-- Step 5 = Agricultural: Agricultural pre-selected (greyed), Commercial + NonProfit_Other disabled -->
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled checked id="bc-agricultural" />
                            <label for="bc-agricultural" class="ui-radio-locked-label">Agricultural (Farming)</label>
                        </div>
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled id="bc-commercial-disabled" />
                            <label for="bc-commercial-disabled" class="ui-radio-locked-label">Commercial</label>
                        </div>
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled id="bc-nonprofit-other-disabled" />
                            <label for="bc-nonprofit-other-disabled" class="ui-radio-locked-label">Non-Profit (other)</label>
                        </div>
                        break;

                    case BusinessCategoryScenario.LockedDomestic:
                        <!-- Step 5 = Domestic: Domestic pre-selected (greyed), Commercial + NonProfit_Other disabled -->
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled checked id="bc-domestic" />
                            <label for="bc-domestic" class="ui-radio-locked-label">Domestic (in a private home)</label>
                        </div>
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled id="bc-commercial-disabled" />
                            <label for="bc-commercial-disabled" class="ui-radio-locked-label">Commercial</label>
                        </div>
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled id="bc-nonprofit-other-disabled" />
                            <label for="bc-nonprofit-other-disabled" class="ui-radio-locked-label">Non-Profit (other)</label>
                        </div>
                        break;

                    case BusinessCategoryScenario.LockedCommercial:
                        <!-- Step 5 = Construction: Commercial pre-selected (greyed), NonProfit_Other disabled -->
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled checked id="bc-commercial"/>
                            <label for="bc-commercial" class="ui-radio-locked-label">Commercial</label>
                        </div>
                        <div class="ui-radio-locked-option">
                            <input type="radio" disabled id="bc-nonprofit-other-disabled" />
                            <label for="bc-nonprofit-other-disabled" class="ui-radio-locked-label">Non-Profit (other)</label>
                        </div>

                        break;
                    case BusinessCategoryScenario.FreeChoice:
                    default:
                        <!-- Step 1 = No + Step 5 = Other: Commercial pre-selected, NonProfit_Other selectable -->
                        <RadioGroup TValue="BusinessCategory?"
                                    LabelledById="BusinessCategory"
                                    Value="SubjectivityModel.BusinessCategory"
                                    ValueChanged="OnBusinessCatagoryChanged"
                                    ValueExpression="() => SubjectivityModel.BusinessCategory"
                                    Options="@BusinessCategoriesLockedAlternatives" />
                        <FieldError For="@(() => SubjectivityModel.BusinessCategory)"
                                    Visible="_formSubmitted" />
                        break;
                }
            </div>

            @if (Section2Visible())
            {
                <div id="section_2" class="ui-radio-section">
                    <p class="page-subtitle" id="HasAppliedFor501c3Status" tabindex="-1">Have you applied for 501(c)(3) status with the IRS?</p>
                    <br />
                    <FieldError For="@(() => SubjectivityModel.HasAppliedFor501c3Status)"
                                Visible="_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="HasAppliedFor501c3Status"
                                Value="SubjectivityModel.HasAppliedFor501c3Status"
                                ValueChanged="OnHasAppliedFor501c3StatusChange"
                                ValueExpression="() => SubjectivityModel.HasAppliedFor501c3Status"
                                Options="@YesNoRadioOptions" />
                 </div>
            }

            <FinancialInstitutionAddr Address="SubjectivityModel.FinancialInstitution"
                          ShowName="true"
                          Legend="Financial Institution for Business Checking Account"
                         Visible="@_showAddressErrors"/>

            <div class="ui-radio-section">
                <p class="ui-text"><strong>Note: </strong>@GetNoteText()<a href=@GetPermittedExclusionsUrl() target='_blank' rel='noopener noreferrer'class="link-underline-primary">Permitted Exclusions</a>.</p>
            </div>
            @if (Section0Visible)
            {
                <div id="section0" class="ui-radio-section">
                    <p class="ui-text" id="HasEmployeesOutsideWisconsin501" tabindex="-1">Do you have employees who work in states other than Wisconsin?</p>
                     <FieldError For="@(() => SubjectivityModel.HasEmployeesOutsideWisconsin501)"
                                Visible=_formSubmitted />
                    <RadioGroup TValue="bool?"
                                LabelledById="HasEmployeesOutsideWisconsin501"
                                Value="SubjectivityModel.HasEmployeesOutsideWisconsin501"
                                ValueChanged="OnHasEmployeesOutsideWisconsinChange501"
                                ValueExpression="() => SubjectivityModel.HasEmployeesOutsideWisconsin501"
                                Options="@YesNoRadioOptions" />
                </div>
            }

            @if (Section3Visible)
            {
                <div id="section3" class="ui-radio-section">
                    <p class="ui-text"  id="HasEmployeesOutsideWisconsin" tabindex="-1">Do you have employees who work in states other than Wisconsin?</p>
                    <FieldError For="@(() => SubjectivityModel.HasEmployeesOutsideWisconsin)"
                                Visible="_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="HasEmployeesOutsideWisconsin"
                                Value="SubjectivityModel.HasEmployeesOutsideWisconsin"
                                ValueChanged="OnHasEmployeesOutsideWisconsinChange"
                                ValueExpression="() => SubjectivityModel.HasEmployeesOutsideWisconsin"
                                Options="@YesNoRadioOptions" />

                </div>
            }

            @if (Section6Visible)
            {
                <div id="section_6" class="ui-radio-section">
                    <p id="HasFutaLiabilityInOtherStates" class="ui-text" tabindex="-1">
                        Do you have a <a href='https://www.irs.gov/taxtopics/tc759' target='_blank' rel='noopener noreferrer'> Federal Unemployment Tax (FUTA)</a> liability based on payrolls in any state other than Wisconsin?
                    </p>
                    <p id="Federal-Unemployment-description" class="ui-radio-description">
                        For-profit entities paying State Unemployment Tax (SUTA) in a state other than Wisconsin often have a FUTA liability.
                        Some non-profit entities may owe SUTA but not FUTA. More details on FUTA liability can be found on the
                        <a href='https://www.irs.gov/taxtopics/tc759' target='_blank' rel='noopener noreferrer'>IRS website</a>.
                    </p>
                    <FieldError For="@(() => SubjectivityModel.HasFutaLiabilityInOtherStates)"
                                Visible="_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="HasFutaLiabilityInOtherStatesl"
                                DescriptionId="Federal-Unemployment-description"
                                Value="SubjectivityModel.HasFutaLiabilityInOtherStates"
                                ValueChanged="OnHasFutaLiabilityInOtherStatesChange"
                                ValueExpression="() => SubjectivityModel.HasFutaLiabilityInOtherStates"
                                Options="@YesNoRadioOptions" />

                </div>
            }

            @* quarter wages question *@
                @if (Section4Visible)
                {
                    <div id="section_4" class="ui-radio-section">
                        <p id="PaidWagesOver1500Employees" class="ui-text" tabindex="-1">@GetWagesQuestion()</p>
                          <FieldError For="@(() => SubjectivityModel.PaidWagesOver1500Employees)"
                                Visible="_formSubmitted" />
                        <RadioGroup TValue="bool?"
                                    LabelledById="PaidWagesOver1500Employees"
                                    Value="SubjectivityModel.PaidWagesOver1500Employees"
                                    ValueChanged="OnPaidWagesOver1500EmployeesChange"
                                    ValueExpression="() => SubjectivityModel.PaidWagesOver1500Employees"
                                    Options="@YesNoRadioOptions" />

                    </div>
                }

                @* quarter wages yes (wage entry box)*@
                    @if (Section5Visible)
                    {
                        @if (SubjectivityModel.Wages != null && SubjectivityModel.Wages.Count > 0 && BusinessCategory != BusinessCategory.NonProfit_501c3)
                        {
                            <p id="table description" class="ui-text">@GetWagesTableDisclaimer()</p>
                            <table id="Wages" tabindex="-1" aria-label="Gross quarterly payroll by year" aria-describedby="table description">
                                <tr style="text-align:center;">
                                    <th class="visually-hidden">Year</th>
                                    <th id="q1-header">Q1</th>
                                    <th id="q2-header">Q2</th>
                                    <th id="q3-header">Q3</th>
                                    <th id="q4-header">Q4</th>
                                </tr>
                                @{int index = 0;}
                                @foreach (var row in SubjectivityModel.Wages)
                                {
                                    <tr class"ui-table-row-header">
                                        <th id="year-@index" scope="row" class="ui-table-row-header">@row.Year</th>

                                        <td class="ui-table-text-box">
                                            <NumericTextBox @bind-Value="row.Q1Wages"
                                                            InputType="@InputDataTypes.Currency"
                                                            ShowCurrencyIcon="false"
                                                            CssClass="@(row.Q1Disabled ? "textboxReadOnlyBackgroundColor" : "")"
                                                            DecimalPlaces="@DecimalPlaces"
                                                            IsReadonly="@row.Q1Disabled"
                                                            Min="0" Max="10000000"
                                                            AriaLabelledBy="@($"q1-header year-{index}")"/>
                                        </td>

                                        <td class="ui-table-text-box">
                                            <NumericTextBox @bind-Value="row.Q2Wages"
                                                            InputType="@InputDataTypes.Currency"
                                                            ShowCurrencyIcon="false"
                                                            CssClass="@(row.Q2Disabled ? "textboxReadOnlyBackgroundColor" : "")"
                                                            DecimalPlaces="@DecimalPlaces"
                                                            IsReadonly="@row.Q2Disabled"
                                                            Min="0" Max="10000000"
                                                            AriaLabelledBy="@($"q2-header year-{index}")"/>

                                        </td>

                                        <td class="ui-table-text-box">
                                            <NumericTextBox @bind-Value="row.Q3Wages"
                                                            InputType="@InputDataTypes.Currency"
                                                            CssClass="@(row.Q3Disabled ? "textboxReadOnlyBackgroundColor" : "")"
                                                            ShowCurrencyIcon="false"
                                                            DecimalPlaces="@DecimalPlaces"
                                                            IsReadonly="@row.Q3Disabled"
                                                            Min="0" Max="10000000"
                                                            AriaLabelledBy="@($"q3-header year-{index}")"/>

                                        </td>

                                        <td class="ui-table-text-box">
                                            <NumericTextBox @bind-Value="row.Q4Wages"
                                                            InputType="@InputDataTypes.Currency"
                                                            CssClass="@(row.Q4Disabled ? "textboxReadOnlyBackgroundColor" : "")"
                                                            ShowCurrencyIcon="false"
                                                            DecimalPlaces="@DecimalPlaces"
                                                            IsReadonly="@row.Q4Disabled"
                                                            Min="0" Max="10000000"
                                                            AriaLabelledBy="@($"q4-header year-{index}")"/>

                                        </td>
                                    </tr>
                                    index++;
                                }

                            </table>
                    <FieldError For="@(() => SubjectivityModel.Wages)"
                                Visible="_formSubmitted" />
                        }
                        <br />
                    }
            @* end quarter wages question *@
            @* quarter employees question *@
            @if (Section9Visible)
            {
                <div id="section_9" class="ui-radio-section">
                    <p id="HasEmployeeIn20Weeks" class="ui-text" tabindex="-1">@EmployeeIn20Weeks()</p>
                    <FieldError For="@(() => SubjectivityModel.HasEmployeeIn20Weeks)"
                                Visible="_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="HasEmployeeIn20Weeks"
                                Value="SubjectivityModel.HasEmployeeIn20Weeks"
                                ValueChanged="OnHasEmployeeIn20WeeksChange"
                                ValueExpression="() => SubjectivityModel.HasEmployeeIn20Weeks"
                                Options="@YesNoRadioOptions" />

                </div>
            }
            @* quarter employees question yes (20th week end date) *@
            @if (Section10Visible)
            {
                <div id="section_10" class="form-row row ui-radio-section">
                    <div class="form-group col-md-6">
                        <label class="form-label" for="Week20EndDate">
                            Date 20th Week Ended
                        </label>
                        <FieldError For="@(() => SubjectivityModel.Week20EndDate)"
                                    Visible="_formSubmitted" />
                        <InputDate id="Week20EndDate"
                                   @bind-Value="SubjectivityModel.Week20EndDate"
                                   class="form-control"
                                   min="@TwentiethWeekMinSaturday().ToString("yyyy-MM-dd")"
                                   step="7"
                                   DisplayName="Date 20th Week Ended"
                                   @bind-Value:format="MM/dd/yyyy" />
                    </div>
                </div>
            }
                @* end quarter wages yes *@
                @* quarter wages no (do you expect to pay wages in a calendar quarter) *@
            @if (Section13Visible)
                    {
                        <div id="section_13" class="ui-radio-section">
                            <p id="ExpectToPayWagesInAQuarter" class="ui-text" tabindex="-1">@GetExpectToPayWagesQuestion()</p>
                            <FieldError For="@(() => SubjectivityModel.ExpectToPayWagesInAQuarter)"
                                        Visible="_formSubmitted" />
                            <RadioGroup TValue="bool?"
                                        LabelledById="ExpectToPayWagesInAQuarter"
                                        Value="SubjectivityModel.ExpectToPayWagesInAQuarter"
                                        ValueChanged="OnExpectToPayWagesInAQuarterChange"
                                        ValueExpression="() => SubjectivityModel.ExpectToPayWagesInAQuarter"
                                        Options="@YesNoRadioOptions" />

                        </div>
                    }
                    @* expect to pay wages in a calendar quarter yes (when?) *@
                        @if(Section14Visible)
                        {
                            <div id="section_14" class="ui-radio-section">
                                <p class="ui-text" id="WhenExpectToPayWagesInAQuarter-label">When?</p>
                                <FieldError For="@(() => SubjectivityModel.WhenExpectToPayWagesInAQuarter)"
                                            Visible="_formSubmitted" />
                                <OutlinedSelectField @bind-Value="SubjectivityModel.WhenExpectToPayWagesInAQuarter"
                                                    Id="WhenExpectToPayWagesInAQuarter"
                                                    AriaLabelledBy="WhenExpectToPayWagesInAQuarter-label"
                                                    AriaDescribedById="ExpectToPayWagesInAQuarter"
                                                     Options="@ExpectedWagesCatagories"
                                                     For="() => SubjectivityModel.WhenExpectToPayWagesInAQuarter"
                                                     Visible="true" />
                            </div>

                        }
                    @* end expect to pay wages in a calendar quater yes*@
                @* end quarter wages no *@

                @* end quater employees question yes *@
                @* quarter employees question no (expect future quarter employees) *@
            @if (Section18Visible)
                    {
                        <div id="section_18" class="ui-radio-section">
                            <p id="ExpectToHaveWagesInAQuarter" class="ui-text" tabindex="-1">@GetExpectToHaveWagesQuestion()</p>
                            <FieldError For="@(() => SubjectivityModel.ExpectToHaveWagesInAQuarter)"
                                        Visible="_formSubmitted" />
                            <RadioGroup TValue="bool?"
                                        LabelledById="ExpectToHaveWagesInAQuarter"
                                        Value="SubjectivityModel.ExpectToHaveWagesInAQuarter"
                                        ValueChanged="OnExpectToHaveWagesInAQuarterChange"
                                        ValueExpression="() => SubjectivityModel.ExpectToHaveWagesInAQuarter"
                                        Options="@YesNoRadioOptions" />

                        </div>
                    }
                    @* expect future quarter employees yes (when?) *@
                        @if (Section19Visible)
                        {
                            <div id="section_19" class="ui-radio-section">
                                <p class="ui-text" id="WhenExpectToHaveWagesInAQuarter-label">When?</p>
                                <FieldError For="@(() => SubjectivityModel.WhenExpectToHaveWagesInAQuarter)"
                                            Visible="_formSubmitted" />
                                <OutlinedSelectField @bind-Value="SubjectivityModel.WhenExpectToHaveWagesInAQuarter"
                                                    Id="WhenExpectToHaveWagesInAQuarter"
                                                    AriaLabelledBy="WhenExpectToHaveWagesInAQuarter-label"
                                                    AriaDescribedById="ExpectToHaveWagesInAQuarter"
                                                    Options="@ExpectedWagesCatagories"
                                                     For="() => SubjectivityModel.WhenExpectToHaveWagesInAQuarter"
                                                     Visible="true" />
                            </div>

                        }
                    @* end expect future quarter employees yes *@
                @* end quarter employees question no *@
            @* end quarter employees question *@

            @if (Section15Visible)
            {
                <div id="section_15" class="ui-radio-section">
                    <p id="PayWagesPerformWI" class="ui-text" tabindex="-1">@PaidWagesPerformWI()</p>
                    <FieldError For="@(() => SubjectivityModel.PayWagesPerformWI)"
                                Visible="_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="PayWagesPerformWI"
                                Value="SubjectivityModel.PayWagesPerformWI"
                                ValueChanged="OnHasPayWagesPerformWI"
                                ValueExpression="() => SubjectivityModel.PayWagesPerformWI"
                                Options="@YesNoRadioOptions" />

                </div>
            }
            @if (Section16Visible)
            {
                <div id="section_16" class="ui-radio-section">
                    <p id ="ExpectToPayWagesPerformWI" class="ui-text" tabindex="-1">@ExpectPayWagesPerformWI()</p>
                    <FieldError For="@(() => SubjectivityModel.ExpectToPayWagesPerformWI)"
                                Visible="_formSubmitted" />
                    <RadioGroup TValue="bool?"
                                LabelledById="ExpectToPayWagesPerformWI"
                                Value="SubjectivityModel.ExpectToPayWagesPerformWI"
                                ValueChanged="OnExpectToPayWagesPerformWI"
                                ValueExpression="() => SubjectivityModel.ExpectToPayWagesPerformWI"
                                Options="@YesNoRadioOptions" />

                </div>
            }
            @if (Section17Visible)
            {
                <div id="section_17" class="ui-radio-section">
                    <p class="ui-text" id="AFL_XPCT_PY_WI_WGS_WHN_TXT-label">When?</p>
                    <FieldError For="@(() => SubjectivityModel.AFL_XPCT_PY_WI_WGS_WHN_TXT)"
                                Visible="_formSubmitted" />
                    <OutlinedSelectField @bind-Value="SubjectivityModel.AFL_XPCT_PY_WI_WGS_WHN_TXT"
                                        Id="AFL_XPCT_PY_WI_WGS_WHN_TXT"
                                        AriaLabelledBy="AFL_XPCT_PY_WI_WGS_WHN_TXT-label"
                                        AriaDescribedById="ExpectToPayWagesPerformWI"
                                         Options="@ExpectedWagesCatagories"
                                         For="() => SubjectivityModel.AFL_XPCT_PY_WI_WGS_WHN_TXT"
                                         Visible="true" />
                </div>
            }
        </EditForm>
        @* <Button Text="Validate" OnClick="Validate"></Button> *@

    </div>
</div>
