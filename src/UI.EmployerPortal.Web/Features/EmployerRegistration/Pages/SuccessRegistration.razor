@page "/employer-registration/SuccessRegistration"
@inject EmployerRegistrationInfo RegistrationInfo
@inject RegistrationStateService RegistrationState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ISessionManager SessionManager

@rendermode InteractiveServer
@using System.Threading.Tasks
@using UI.EmployerPortal.Generated.ServiceClients.PortalCorrespondenceService
@using UI.EmployerPortal.Razor.SharedComponents
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners;
@using UI.EmployerPortal.Web.Auth
@using UI.EmployerPortal.Web.Features.EmployerRegistration.Components
@using UI.EmployerPortal.Web.Features.EmployerRegistration.Models
@using UI.EmployerPortal.Web.Features.EmployerRegistration.Services
@using UI.EmployerPortal.Web.Features.Landing
@using UI.EmployerPortal.Web.Features.Shared.Accounts.Services
@using UI.EmployerPortal.Web.Features.Shared.Registrations.Models
@using UI.EmployerPortal.Web.Features.Shared.Session.Managers
@using UI.EmployerPortal.Web.Features.Shared.Session.Models
@using UI.EmployerPortal.Web.Logging.NavigationSession

@inject INavigationSessionTracker tracker



<PageTitle>Employer Registration Complete</PageTitle>
<div class="page_wrapper">
    <div class="registration-complete-container">
        <div id="status-notification-container" role="status">
            @if (showBanner)
            {
                <NotificationBanner
                    Message="Initial Determination letter will be mailed to your main business mailing address."
                    NotificationType=NotificationType.Confirmation>
                </NotificationBanner>
            }
        </div>
        @if (isLoading)
        {
            <div>


                <div class="transparent-sucess-content">
                    <div class="success-header">
                        <img src="icons/check_circle_green.svg" width="30" alt=""/>
                        <h1 class="success-title">You Have Successfully Completed the Employer Registration</h1>
                    </div>

                    <div class="account-info">
                        <p class="account-text">
                            Your account number is on the
                            <a href="#"
                               class="text-button @(isLoading ? "disabled-link" : "")"
                               data-determination-letter aria-disabled="@isLoading"
                               @onclick:preventDefault="true"
                               @onclick="@(() => tracker.LogNavigationSessionActivity(DownloadPdf, "Initial Determination(ID) Clicked", DateTime.Now))">Initial Determination(ID)
                           </a>
                            <img src="icons/check_circle_blue.svg" width="30" alt=""/>
                        </p>
                    </div>
                </div>
                <LoadingSpinner Message="Loading..." />
             </div>
            <br />
            <div class="mail-a-copy">
                <button class="text-button" @onclick="@(() => tracker.LogNavigationSessionActivity(ShowNotification, "Mail a Copy of the ID Clicked", DateTime.Now))">Mail a copy of the ID</button> to the main business mailing address
            </div>
        }
        else
        {

            @if (showIdLetterErrorBanner)
            {
                <div class="row nb-alert" role="alert" b-7npt0yvdkt="">
                    <div class="col text-start" b-7npt0yvdkt=""><!--!-->
                        <img src="_content/UI.EmployerPortal.Razor.SharedComponents/icons/alert-notification.svg" class="sort-icon" alt="Alert">
                        <span class="nb-text">
                            <strong class="mb-2 me-2">The system couldn't load the Initial Determination letter, but your account is now open.</strong>
                            <br />
                            You can view the Initial Determination letter in UI Documents when it is available.
                        </span>
                    </div>
                </div>
                <br />
            }

            <div class="success-header">
                <img src="icons/check_circle_green.svg" width="30" alt=""/>
                <h1 class="success-title">You Have Successfully Completed the Employer Registration</h1>
            </div>

            <div class="account-info">
                <p class="account-text">
                    <a href="#"
                       class="text-button @(isLoading ? "disabled-link" : "")"
                       data-determination-letter aria-disabled="@isLoading"
                       @onclick:preventDefault="true"
                       @onclick="@(() => tracker.LogNavigationSessionActivity(DownloadPdf, "Initial Determination(ID) Clicked", DateTime.Now))">
                        Initial Determination(ID)
                    </a>
                    <img src="icons/check_circle_blue.svg" width="30" alt=""/>
                </p>
            </div>

            <br />

            <div class="mail-a-copy">
                <button class="text-button" @onclick="@(() => tracker.LogNavigationSessionActivity(ShowNotification, "Mail a copy of the ID to the main business mailing address Clicked", DateTime.Now))">Mail a copy of the ID to the main business mailing address</button>
            </div>

            <br />

            @if (ShowBusinessTransferFormLink || ShowMissingQuarters)
            {
                <div class="whats-next-container">
                    <h2 class="whats-next-title">What's Next?</h2>

                    @if (ShowBusinessTransferFormLink)
                    {
                        <div class="whats-next-section">
                            <p class="whats-next-text">
                                Based on the information provided, you must complete and submit the UCT-115-E Report of Business Transfer form
                            </p>
                            <a href="https://dwd.wisconsin.gov/dwd/forms/ui/pdf/uct-115-e.pdf" target="_blank">Download the Report of Business Transfer (UCT-115-E)</a>
                        </div>
                        <br />
                    }

                    @if (ShowMissingQuarters)
                    {
                        <div class="whats-next-section">
                            <p class="whats-next-text">
                                You are required to file Tax and Wage Reports for :
                            </p>
                            <ul class="whats-next-table">
                                @foreach (var q in missingQuarters)
                                {
                                    <li>@q</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }

            <div class="action-buttons">
                <Button Text="GO TO DASHBOARD"
                        Variant="Button.ButtonVariant.Primary"
                        Size="Button.ButtonSize.Medium"
                        Onclick="@(() => tracker.LogNavigationSessionActivity(GoToDashboard, "Go To Dashboard Clicked", DateTime.Now))" />

                <Button Text="REGISTER ANOTHER EMPLOYER"
                        Variant="Button.ButtonVariant.Secondary"
                        Size="Button.ButtonSize.Medium"
                        Onclick="@(() => tracker.LogNavigationSessionActivity(RegisterAnotherEmployer, "Register Another Employer Clicked", DateTime.Now))" />
            </div>
        }
    </div>
    <RegistrationManagerAccessModal IsOpen="@_isModalOpen"
                               OnClose="HandleModalClose" />
</div>
@code {

    [Parameter]
    public  int employerSK { get; set; }
    [Parameter]
    public int? generationSK { get; set; }

    [Inject]
    private IEmployerAccountService EmployerAccountService { get; set; } = default!;
    [Inject]
    private IEmployerRegistrationServices EmployerRegistrationServices { get; set; } = default!;
    [Inject]
    private ILandingOrchestrator LandingOrchestrator { get; set; } = default!;
    [Inject]
    private EmployerRegistrationModelStore EmployerRegistrationModelStore { get; set; } = default!;
    [Inject]
    private ILayoutOrchestator LayoutOrchestator { get; set; } = default!;
    [Inject]
    private ISessionManager sessionManger { get; set; } = default!;

    [Inject]
    private IEmployerAccessProvider EmployerAccessProvider { get; set; } = default!;

    public List<string> missingQuarters = new();
    public bool showBanner = false;
    private bool isLoading = false;
    private bool _isModalOpen = false;

    private bool showIdLetterErrorBanner = false;

    //WCF call to bring list of all pending quarters to file Tax and Wage Reports.
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Show Modal on page load
        _isModalOpen = true;

        var sessionEmployerRegistrationInfo = await sessionManger.GetAsync<SessionEmployerRegistrationInfo>();
        var employerSK = sessionEmployerRegistrationInfo?.EmployerSk ?? 0;
        //WCF call to get Missing Quarters to file Tax and wage reports.
        var missingInfo = await EmployerAccountService.GetMissingQuartersInfo(employerSK);

        //Replacing " " with "/" as per business requirement.
        missingQuarters = missingInfo.Select(x => x.Replace(" ", "/")).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("determinationLetter.initialize");
        }
    }

    private void HandleModalClose()
    {
        _isModalOpen = false;
    }


    private async Task GoToDashboard()
    {
        var sessionEmployerRegistrationInfo = await sessionManger.GetAsync<SessionEmployerRegistrationInfo>();
        var employerSK = sessionEmployerRegistrationInfo?.EmployerSk ?? 0;
        var registeredEmployerAccount = await EmployerAccountService.GetRegisterEmployerAccount(employerSK);

        if (registeredEmployerAccount == null) return;

        await LandingOrchestrator.SelectAccountAsync(registeredEmployerAccount);
        await EmployerAccessProvider.ResetEmployerAccess();

        RegistrationState.ClearForNewRegistration();
        RegistrationInfo.ClearForNewRegistration();
        await LayoutOrchestator.RequestEmployerListRefreshAsync("New Registration completed successfully.");
        NavigationManager.NavigateTo("employer-dashboard", true);
    }

    private void RegisterAnotherEmployer()
    {
        RegistrationState.ClearForNewRegistration();
        RegistrationInfo.ClearForNewRegistration();
        NavigationManager.NavigateTo("employer-registration", true);
    }

    public async Task ShowNotification()
    {
        await EmployerRegistrationModelStore.MailId();

        showBanner = true;
    }

    public bool ShowBusinessTransferFormLink =>
        (EmployerRegistrationModelStore.EmployerRegistrationModel.PreliminaryQuestionsModel.AcquiredExistingBusiness.HasValue
            && EmployerRegistrationModelStore.EmployerRegistrationModel.PreliminaryQuestionsModel.AcquiredExistingBusiness.Value)
        || (EmployerRegistrationModelStore.EmployerRegistrationModel.PreliminaryQuestionsModel.SelectedNoEmployeeReason.HasValue
            && EmployerRegistrationModelStore.EmployerRegistrationModel.PreliminaryQuestionsModel.SelectedNoEmployeeReason.Value == NoEmployeeReason.HaveSoldOrTransferredBusiness);

    public bool ShowMissingQuarters =>
        missingQuarters != null && missingQuarters.Any();

    public async Task DownloadPdf()
    {
        // Prevent multiple clicks while PDF is being generated
        if (isLoading)
            return;

        isLoading = true;
        showIdLetterErrorBanner = false;

        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        bool pdfOpened = false;

        try
        {
            var deadline = DateTime.UtcNow.AddSeconds(45);
            var pollInterval = TimeSpan.FromSeconds(5);
            var sessionEmployerRegistrationInfo = await sessionManger.GetAsync<SessionEmployerRegistrationInfo>();

            while (DateTime.UtcNow < deadline)
            {
                try
                {
                    var request = new PortalCorrespondenceIDRequest()
                    {
                        EmployerSK = sessionEmployerRegistrationInfo?.EmployerSk ?? 0,
                        GenerationSK = sessionEmployerRegistrationInfo?.EmployerGenerationSk ?? 0

                    };
                    var result = await EmployerRegistrationServices.GeneratePDFIDForRegistration(request);
                    string pdfFilePath = result.PDFFilePath;

                    if (!string.IsNullOrEmpty(pdfFilePath) && File.Exists(pdfFilePath))
                    {
                        await using var fileStream = File.OpenRead(pdfFilePath);
                        using var streamRef = new DotNetStreamReference(stream: fileStream);

                        pdfOpened = await JS.InvokeAsync<bool>(
                            "determinationLetter.openPdf",
                            streamRef);

                        if (pdfOpened)
                        {
                            return;
                        }

                        showIdLetterErrorBanner = true;
                        return;
                    }

                }
                catch
                {
                    // Service call failed — continue retrying
                }

                var remaining = deadline - DateTime.UtcNow;
                var delay = remaining < pollInterval ? remaining : pollInterval;
                if (delay > TimeSpan.Zero)
                    await Task.Delay(delay);
            }
            // 45 seconds elapsed, PDF still not available
            showIdLetterErrorBanner = true;
        }
        finally
        {
            if (!pdfOpened)
            {
                await JS.InvokeVoidAsync(
                    "determinationLetter.cancel");
            }

            isLoading = false;

            await InvokeAsync(StateHasChanged);
        }
    }
}
