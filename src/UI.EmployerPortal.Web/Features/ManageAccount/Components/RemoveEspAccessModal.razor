@using UI.EmployerPortal.Razor.SharedComponents
@using Microsoft.AspNetCore.Components.Web
@using UI.EmployerPortal.Web.Logging.NavigationSession
@inject INavigationSessionTracker tracker

@if (IsVisible)
{
    <div class="modal-overlay" role="presentation">
        <div class="modal-container"
             role="dialog"
             aria-modal="true"
             aria-labelledby="remove-esp-access-modal-title"
             aria-describedby="remove-esp-access-modal-body"
             @onkeydown="HandleKeyDown"
             tabindex="-1"
             @ref="_modalRef">
            <div class="modal-header">
                <h3 id="remove-esp-access-modal-title" class="modal-title">Remove ESP Access?</h3>
                <button class="modal-close" @onclick="@(() => tracker.LogNavigationSessionActivity(OnCancel, "Remove ESP Access Clicked", DateTime.Now))">
                    <img src="icons/close_x_blue.svg" />
                </button>
            </div>
            <div id="remove-esp-access-modal-body" class="modal-body">
                <p>Are you sure you want to remove this ESP's access for this account?</p>
            </div>
            <div class="modal-footer">
                <Button Variant="Button.ButtonVariant.Secondary"
                        type="button"
                        ShowBorder="false"
                        Onclick="@(() => tracker.LogNavigationSessionActivity(OnCancel, "Do Not Remove ESP Access Clicked", DateTime.Now))">
                    DO NOT REMOVE ESP ACCESS
                </Button>
                <Button Variant="Button.ButtonVariant.Secondary"
                        type="button"
                        Onclick="@(() => tracker.LogNavigationSessionActivity(OnConfirm, "Remove ESP Access Clicked", DateTime.Now))">
                    REMOVE ESP ACCESS
                </Button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private ElementReference _modalRef;
    private bool _wasVisible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_wasVisible)
        {
            _wasVisible = true;
            await _modalRef.FocusAsync();
        }
        else if (!IsVisible && _wasVisible)
        {
            _wasVisible = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Escape key dismissal
        if (e.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
    }
}
