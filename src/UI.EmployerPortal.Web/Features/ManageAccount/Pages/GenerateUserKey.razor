@page "/manage-account/account-users/generate-key"
@using UI.EmployerPortal.Razor.SharedComponents
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using UI.EmployerPortal.Web.Features.QuarterlyTax.Components.SelectReport
@using UI.EmployerPortal.Web.Logging.NavigationSession
@inject INavigationSessionTracker tracker

<PageTitle>Generate User Key</PageTitle>

<div class="gen-key-page">

    <h1 class="gen-key-title">Generate User Key</h1>

    @if (_isLoading)
    {
        <LoadingSpinner Message="Loading access key types..." />
    }
    else if (_hasError)
    {
        <NotificationBanner NotificationType="NotificationType.Alert"
                            MessageStyle="MessageStyle.MultiLine"
                            Messages='new List<string> { "Unable to load the access key types." }' />
    }
    else if (!_isCurrentUserManager)
    {
        <div class="gen-key-error-wrapper">
            <NotificationBanner NotificationType="NotificationType.Alert"
                                Title="Access Denied"
                                Message="Your account currently does not have access to view this page. Please contact your account manager for further assistance." />
        </div>
    }
    else
    {
        <p id="radiogroup-label" class="gen-key-subtitle">Select an access key type.</p>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="gen-key-error-wrapper">
                <NotificationBanner NotificationType="NotificationType.Alert"
                                    MessageStyle="MessageStyle.MultiLine"
                                    Messages='new List<string> { _errorMessage }' />
            </div>
        }
        <div class="function-cards" role="radiogroup" aria-labelledby="radiogroup-label" aria-required="true">
            @if (_isEspUser)
            {
                @* ── Worker card ── *@
                <ReportingMethodCard
                    Id="reporting-card-0"
                    Title="Worker Access Key"
                    BoldTitle="true"
                    IsSelected="@(_selectedIndex == 0)"
                    OnSelected="@(() => HandleCardSelected(0))"
                    OnNextCardSelected="HandleNextCard"
                    OnPreviousCardSelected="HandlePreviousCard">
                    <CustomDescription>
                        <div class="gen-key-card-body">
                            <ul class="gen-key-card-list">
                                <li>Workers can access all clients.</li>
                                <li>Workers can establish employer service provider relationships.</li>
                                <li>Workers can not remove clients.</li>
                                <li>Workers can not add or remove other workers or managers.</li>
                            </ul>
                        </div>
                    </CustomDescription>
                </ReportingMethodCard>
                @* ── Manager card ── *@
                <ReportingMethodCard
                    Id="reporting-card-1"
                    Title="Manager Access Key"
                    BoldTitle="true"
                    IsSelected="@(_selectedIndex == 1)"
                    OnSelected="@(() => HandleCardSelected(1))"
                    OnNextCardSelected="HandleNextCard"
                    OnPreviousCardSelected="HandlePreviousCard">
                    <CustomDescription>
                        <div class="gen-key-card-body">
                            <p class="gen-key-card-text">In addition to all worker permissions, managers will be able to:</p>
                            <ul class="gen-key-card-list">
                                <li>Remove user access.</li>
                                <li>Generate access keys for other managers and workers.</li>
                            </ul>
                        </div>
                    </CustomDescription>
                </ReportingMethodCard>
            }
            else
            {
                @* ── Worker card ── *@
                <ReportingMethodCard
                    Id="reporting-card-0"
                    Title="Worker Access Key"
                    BoldTitle="true"
                    IsSelected="@(_selectedIndex == 0)"
                    OnSelected="@(() => HandleCardSelected(0))"
                    OnNextCardSelected="HandleNextCard"
                    OnPreviousCardSelected="HandlePreviousCard">
                    <CustomDescription>
                        <div class="gen-key-card-body">
                            <p class="gen-key-card-text">Workers will only have access to selected permissions.</p>
                        </div>
                    </CustomDescription>
                </ReportingMethodCard>
                @* ── Manager card ── *@
                <ReportingMethodCard
                    Id="reporting-card-1"
                    Title="Manager Access Key"
                    BoldTitle="true"
                    IsSelected="@(_selectedIndex == 1)"
                    OnSelected="@(() => HandleCardSelected(1))"
                    OnNextCardSelected="HandleNextCard"
                    OnPreviousCardSelected="HandlePreviousCard">
                    <CustomDescription>
                        <div class="gen-key-card-body">
                            <p class="gen-key-card-text">In addition to all worker permissions, managers will be able to:</p>
                            <ul class="gen-key-card-list">
                                <li>Remove and edit user access.</li>
                                <li>Generate access keys for other managers and workers.</li>
                                <li>Establish employer service provider relationships.</li>
                            </ul>
                            <p class="gen-key-card-text gen-key-card-emphasis">
                                Users in the manager role will have full access to all functions of the Employer Portal.
                            </p>
                        </div>
                    </CustomDescription>
                </ReportingMethodCard>
            }
        </div>

        @* ── Footer ── *@
        <div class="gen-key-footer">
            <Button Text="BACK"
                    Variant="Button.ButtonVariant.Secondary"
                    Onclick="@(() => tracker.LogNavigationSessionActivity(HandleBack, "Back Clicked", DateTime.Now))"
                    Disabled="_isWorking" />
            <Button Text="CONTINUE"
                    Variant="Button.ButtonVariant.Primary"
                    Onclick="@(() => tracker.LogNavigationSessionActivity(HandleContinueAsync, "Continue Clicked", DateTime.Now))"
                    Disabled="_isWorking" />
        </div>
    }
</div>
