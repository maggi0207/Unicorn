@page "/Pages/AccessAccount"
@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using UI.EmployerPortal.Web.Features.ManageAccount.Components
@using UI.EmployerPortal.Web.Logging.NavigationSession
@inject INavigationSessionTracker tracker
@using static UI.EmployerPortal.Razor.SharedComponents.Button
@inherits UI.EmployerPortal.Web.Auth.EmployerAuthorizedPage
<PageTitle>Get Account Access</PageTitle>
<div class="gak-page-container">
    @* ── Header ── *@
    <div class="account-header">
        <div class="account-details fs-xl">
            <div class="account-info">
                <span class="detail-item account-name">
                    <span class="detail-label">Get Account Access</span>
                </span>
            </div>
        </div>
        <div class="account-details fs-sm">
            <div class="account-info">
                <span class="detail-value fw-normal">Access the Employer Portal.</span>
            </div>
        </div>
    </div>
    <div class="gak-body">
        <div role="status">
            @if (_successMessage != null)
            {
                <NotificationBanner NotificationType="NotificationType.Confirmation"
                                    Message="@_successMessage"> </NotificationBanner>
            }
        </div>
        <div role="alert">
            @if (_serviceError != null)
            {

                <NotificationBanner NotificationType="NotificationType.Alert"
                                    Message="@_serviceError">
                </NotificationBanner>
            }
        </div>
        @* ── Section bar ── *@
        <div class="gak-section-bar">Enter Access Key</div>

        @* ── EditForm wraps body + footer so submit button is inside the form ── *@
        <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <div class="gak-main-body">
                <p class="gak-description">Enter your access key and the associated UI Account Number.</p>


                <OutlinedTextField Label="Access Key"
                                   Id="gak-key"
                                   @bind-Value="_form.AccessKey"
                                   For="@(() => _form.AccessKey)"
                                   Placeholder="Enter Access Key"
                                   Disabled="@_isLoading"
                                   Required="true" />

                <OutlinedTextField Label="UI Account Number"
                                   Id="gak-account"
                                   @bind-Value="_form.EmployerAccountNumber"
                                   For="@(() => _form.EmployerAccountNumber)"
                                   Placeholder="Enter UI Account Number"
                                   Mask="000000-000-0"
                                   InputMode="numeric"
                                   Disabled="@_isLoading"
                                   Required="true" />

                <button type="button"
                        class="gak-request-key-link"
                        @onclick="@(() => tracker.LogNavigationSessionActivity(OpenRequestAccessKeyModal, "Don't have an access key Clicked", DateTime.Now))"
                        disabled="@_isLoading">
                    Don't have an access key?
                </button>
            </div>

            @* ── Footer ── *@
            <div class="gak-footer">
                <Button Variant="ButtonVariant.Secondary"
                        Disabled="@_isLoading"
                        Onclick="@(() => tracker.LogNavigationSessionActivity(HandleBack, "Back Clicked", DateTime.Now))">
                    <img src="@(Assets["icons/chevron-left.svg"])" alt="" />
                    BACK
                </Button>

                <Button Type="submit"
                        Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    CONTINUE <img src="@(Assets["icons/chevron-right.svg"])" alt="" />
                </Button>
            </div>
        </EditForm>
    </div>
</div>

<RequestAccessKeyModal IsOpen="_isRequestKeyModalOpen"
                       IsBusy="_isMailingKey"
                       ServiceError="@_mailKeyError"
                       OnCancel="CloseRequestAccessKeyModal"
                       OnClearServiceError="ClearMailKeyError"
                       OnMailAccessKey="HandleMailAccessKey" />
