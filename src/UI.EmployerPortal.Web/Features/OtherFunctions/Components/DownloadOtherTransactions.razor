@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using UI.EmployerPortal.Razor.SharedComponents.Navigation
@using UI.EmployerPortal.Razor.SharedComponents.NotificationBanners
@using UI.EmployerPortal.Razor.SharedComponents.Validation
@using UI.EmployerPortal.Web.Features.OtherFunctions.Models
@using UI.EmployerPortal.Web.Features.OtherFunctions.Services
@using UI.EmployerPortal.Web.Features.Shared.Components
@using System.Globalization
@using UI.EmployerPortal.Web.Logging.NavigationSession
@inject INavigationSessionTracker tracker
@implements IAsyncDisposable
<PageTitle>Download Other RFB Transactions</PageTitle>
<div class="download-transactions-entry">
    @if (_editContext != null)
    {
        <EditForm EditContext="_editContext">
            <CustomValidator @ref="_customValidator" />
            <PageHeader id="page-heading" tabindex="-1" Text="Download Other RFB Transactions That Affect Your Reserve Fund Balance" />
            <ValidationErrorSummary ShowSummary="_showValidationSummary"
                                    FieldIds="_validationFieldIds" />
            @if (!string.IsNullOrEmpty(DownloadTransactionModel?.NoRecordsFoundMessage))
            {
                <div id="download-info-banner" tabindex="-1" role="status">
                    <NotificationBanner NotificationType="NotificationType.Information"
                                        MessageStyle="MessageStyle.SingleLine"
                                        Message="@DownloadTransactionModel.NoRecordsFoundMessage" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_downloadErrorMessage))
            {
                <div id="download-error-banner" tabindex="-1" role="alert">
                    <NotificationBanner NotificationType="NotificationType.Alert"
                                        MessageStyle="MessageStyle.SingleLine"
                                        Message="@_downloadErrorMessage" />
                </div>
            }
            <div class="page-content">
                Download records of Other Transactions that affect your Reserve Fund Balance. To get started:
            </div>
            <br />
            <div class="page-content">
                <ol>
                    <li>Choose a <b>File Type</b></li>
                    <li>Select a <b>Date Range</b> based on statement end date.</li>
                    <li>Select <b>Download</b></li>
                </ol>
            </div>
            <br />

            <div class="page-content">
                Data is available up to three years. For more information, see our
                <ExternalLink Url="https://dwd.wisconsin.gov/uitax/downloadRFB.pdf"
                              Text="Instructions"
                              OpenNew="true"
                              Inline="true" /> or the
                <button type="button" class="inline-text-link inline-text-link-button" @onclick="@(() => tracker.LogNavigationSessionActivity(OpenCalendarDrawer, "Benefit Week and Statement Calendar Clicked", DateTime.Now))">Benefit Week and Statement Calendar</button>.
            </div>

            <br />
            <br />
            @if (DownloadTransactionModel?.QuarterOptions?.Count > 0)
            {
                <div class="file-type-container">
                    <label for="dtFileType" class="file-type-label">
                        File Type
                    </label>
                    <OutlinedSelectField Id="dtFileType"
                                         Options="@DownloadTransactionModel.QuarterOptions"
                                         For="@(DownloadTransactionModel.ForFileType)"
                                         @bind-Value="DownloadTransactionModel.FileTypeSelected">
                    </OutlinedSelectField>
                    @if (!string.IsNullOrEmpty(DownloadTransactionModel?.FileTypeError))
                    {
                        <div class="field-error">@DownloadTransactionModel.FileTypeError</div>
                    }
                </div>
            }
            <br />
            <fieldset class="container-dt">
                <legend class="options-legend"><b>Date Range Option</b></legend>
                <br />
                <div class="option">
                    <input id="period" type="radio" name="dataRange" value="period" aria-describedby="period-description" checked="@(DownloadTransactionModel?.SelectedDateRangeOption == "period")"
                           @onchange='() => SetDateRange("period")'>
                    <label for="period">
                        Download records for most recent completed period
                    </label>
                    <div id="period-description" class="date-range">
                        (@DownloadTransactionModel?.BenefitDateRangeModel?.CurrentWeek?.Start  - @DownloadTransactionModel?.BenefitDateRangeModel?.CurrentWeek?.End)
                    </div>
                </div>
                <div class="option">
                    <input id="quarter" type="radio" name="dataRange" value="quarter" aria-describedby="quarter-description" checked="@(DownloadTransactionModel?.SelectedDateRangeOption == "quarter")"
                           @onchange='() => SetDateRange("quarter")'>
                    <label for="quarter">
                        Download records for most recent completed quarter
                    </label>
                    <div id="quarter-description" class="date-range">
                        (@DownloadTransactionModel?.BenefitDateRangeModel?.QuarterYear?.Start  - @DownloadTransactionModel?.BenefitDateRangeModel?.QuarterYear?.End)
                    </div>
                </div>
                <div class="option">
                    <input id="fiscal" type="radio" name="dataRange" value="fiscal" aria-describedby="date-range-description" checked="@(DownloadTransactionModel?.SelectedDateRangeOption == "fiscal")"
                           @onchange='() => SetDateRange("fiscal")'>
                    <label for="fiscal">
                        Download records for most recent completed fiscal year
                    </label>
                    <div id="date-range-description" class="date-range">
                        (@DownloadTransactionModel?.BenefitDateRangeModel?.FiscalYear?.Start  - @DownloadTransactionModel?.BenefitDateRangeModel?.FiscalYear?.End)
                    </div>
                </div>
                <div class="option">
                    <input id="statement" type="radio" name="dataRange" value="statement" checked="@(DownloadTransactionModel?.SelectedDateRangeOption == "statement")"
                           @onchange='() => SetDateRange("statement")'>
                    <label id="statement-label" for="statement">
                        Download records for statement ending dates
                    </label>

                    @if (DownloadTransactionModel?.SelectedDateRangeOption == "statement")
                    {
                        <div class="custom-date-container">

                            <div class="date-fields">
                                <div class="date-field-wrapper">
                                    <OutlinedTextField Label="From"
                                                       Id="From"
                                                       Type="date"
                                                       aria-describedby="statement-label"
                                                       @bind-Value="CustomStartDate"
                                                       For="() => CustomStartDate" />
                                </div>
                                <div class="date-field-wrapper">
                                    <OutlinedTextField Label="To"
                                                       Id="To"
                                                       Type="date"
                                                       aria-describedby="statement-label"
                                                       @bind-Value="CustomEndDate"
                                                       For="() => CustomEndDate" />
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(DownloadTransactionModel?.CustomDateRangeError))
                            {
                                <div class="field-error">@DownloadTransactionModel.CustomDateRangeError</div>
                            }
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(DownloadTransactionModel?.DateRangeError))
                {
                    <div class="field-error">@DownloadTransactionModel.DateRangeError</div>
                }
            </fieldset>

            <div class="action-buttons">
                <div class="action-buttons-left">
                    <Button Variant="Button.ButtonVariant.Secondary"
                            OnClick="@(() => tracker.LogNavigationSessionActivity(HandleBack, "Back Clicked", DateTime.Now))">
                        <img src="@(Assets["icons/chevron-left.svg"])" alt="" />
                        BACK
                    </Button>
                    <Button Variant="Button.ButtonVariant.NoOutline"
                            OnClick="@(() => tracker.LogNavigationSessionActivity(HandleClear, "Clear Clicked", DateTime.Now))">
                        CLEAR
                    </Button>
                </div>
                <Button Variant="Button.ButtonVariant.Primary" Size="Button.ButtonSize.Medium"
                        OnClick="@(() => tracker.LogNavigationSessionActivity(handledownload, "Download Clicked", DateTime.Now))">
                    DOWNLOAD <img src="@(Assets["icons/chevron-right.svg"])" alt="" />
                </Button>
            </div>
        </EditForm>
    }
</div>
<BenefitWeekCalendarDrawer IsOpen="_calendarDrawerOpen" OnClose="CloseCalendarDrawer" />

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    [Inject]
    private IDownloadTransactionService DownloadTransactionService { get; set; } = default!;
    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private const string CustomDateRangeKey = "CustomDateRange";
    private readonly Dictionary<string, string> _validationFieldIds = new()
    {
        { nameof(DownloadTransactionModel.FileTypeSelected), "dtFileType" },
        { nameof(DownloadTransactionModel.SelectedDateRangeOption), "period" },
        { CustomDateRangeKey, "From" },
    };

    private readonly Dictionary<FieldIdentifier, List<string>> _fieldErrors = new();
    private EditContext? _editContext;
    private CustomValidator? _customValidator;
    private bool _showValidationSummary;
    private bool _focusSummaryPending;
    private string? _downloadErrorMessage;
    private bool _noRecordsBannerShown;
    private bool _downloadErrorBannerShown;
    private const string ValidationSummaryId = "validation-error-summary";
    private IJSObjectReference? _validationModule;

    public string CustomStartDate = string.Empty;
    public string CustomEndDate = string.Empty;
    private bool _calendarDrawerOpen;

    private void OpenCalendarDrawer()
    {
        _calendarDrawerOpen = true;
    }
    private void CloseCalendarDrawer()
    {
        _calendarDrawerOpen = false;
    }

    [Parameter] public DownloadTransactionModel DownloadTransactionModel { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (_editContext == null || !ReferenceEquals(_editContext.Model, DownloadTransactionModel))
        {
            _editContext = new EditContext(DownloadTransactionModel);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusElementAsync("page-heading");
            return;
        }
        if (_focusSummaryPending && _showValidationSummary)
        {
            _focusSummaryPending = false;
            await FocusElementAsync(ValidationSummaryId);
            return;
        }

        var noRecordsVisible = !string.IsNullOrEmpty(DownloadTransactionModel?.NoRecordsFoundMessage);
        if (noRecordsVisible && !_noRecordsBannerShown)
        {
            await FocusElementAsync("download-info-banner");
        }
        _noRecordsBannerShown = noRecordsVisible;

        var downloadErrorVisible = !string.IsNullOrEmpty(_downloadErrorMessage);
        if (downloadErrorVisible && !_downloadErrorBannerShown)
        {
            await FocusElementAsync("download-error-banner");
        }
        _downloadErrorBannerShown = downloadErrorVisible;
    }

    private async Task FocusElementAsync(string elementId)
    {
        _validationModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/validation.js");
        await _validationModule.InvokeVoidAsync("focusElement", elementId);
    }

    public void HandleBack()
    {
        NavigationManager.NavigateTo("other-functions/benefit-charges");
    }
    public void SetDateRange(string option)
    {
        DownloadTransactionModel.SelectedDateRangeOption = option;
        if (option != "statement")
        {
            CustomStartDate = string.Empty;
            CustomEndDate = string.Empty;
            DownloadTransactionModel.CustomDateRangeError = null;
        }
    }
    public void HandleClear()
    {
        DownloadTransactionModel.SelectedDateRangeOption = string.Empty;
        DownloadTransactionModel.FileTypeSelected = string.Empty;
        DownloadTransactionModel.FileTypeError = null;
        DownloadTransactionModel.DateRangeError = null;
        DownloadTransactionModel.CustomDateRangeError = null;
        DownloadTransactionModel.NoRecordsFoundMessage = null;
        ResetValidationState();
        CustomStartDate = string.Empty;
        CustomEndDate = string.Empty;
        StateHasChanged();
    }
    public async void handledownload()
    {
        ResetValidationState();
        if (!ValidateForm())
        {
            ShowValidationSummary();
            StateHasChanged();
            return;
        }
        var (startDate, endDate) = ResolveDateRange();
        DownloadTransactionModel!.DownloadReportRequest.FromDate = startDate;
        DownloadTransactionModel.DownloadReportRequest.ToDate = endDate;
        ApplyFileExtension();
        await ExecuteDownloadAsync();
    }
    private void ResetValidationState()
    {
        DownloadTransactionModel.FileTypeError = null;
        DownloadTransactionModel.DateRangeError = null;
        DownloadTransactionModel.CustomDateRangeError = null;
        DownloadTransactionModel.NoRecordsFoundMessage = null;
        _downloadErrorMessage = null;
        _fieldErrors.Clear();
        _customValidator?.ClearErrors();
        _showValidationSummary = false;
    }
    private void AddFieldError(string fieldKey, string message)
    {
        var field = new FieldIdentifier(DownloadTransactionModel, fieldKey);
        if (!_fieldErrors.TryGetValue(field, out var messages))
        {
            messages = new List<string>();
            _fieldErrors[field] = messages;
        }
        messages.Add(message);
    }
    private void ShowValidationSummary()
    {
        _customValidator?.DisplayErrors(_fieldErrors);
        _showValidationSummary = true;
        _focusSummaryPending = true;
    }
    private bool ValidateForm()
    {
        bool isValid = true;
        if (string.IsNullOrEmpty(DownloadTransactionModel?.FileTypeSelected))
        {
            DownloadTransactionModel!.FileTypeError = "Please select a File Type.";
            AddFieldError(nameof(DownloadTransactionModel.FileTypeSelected), "Please select a File Type.");
            isValid = false;
        }
        if (string.IsNullOrEmpty(DownloadTransactionModel?.SelectedDateRangeOption))
        {
            DownloadTransactionModel!.DateRangeError = "Please select a Date Range Option.";
            AddFieldError(nameof(DownloadTransactionModel.SelectedDateRangeOption), "Please select a Date Range Option.");
            isValid = false;
        }
        if (!ValidateStatementDateRange())
        {
            isValid = false;
        }
        return isValid;
    }
    private bool ValidateStatementDateRange()
    {
        if (DownloadTransactionModel?.SelectedDateRangeOption?.ToLower() != "statement")
        {
            return true;
        }
        if (string.IsNullOrEmpty(CustomStartDate) || string.IsNullOrEmpty(CustomEndDate))
        {
            DownloadTransactionModel!.CustomDateRangeError = "Both From and To dates are required.";
            AddFieldError(CustomDateRangeKey, "Both From and To dates are required.");
            return false;
        }
        var start = DateOnly.Parse(CustomStartDate, CultureInfo.InvariantCulture);
        var end = DateOnly.Parse(CustomEndDate, CultureInfo.InvariantCulture);
        if (start > end)
        {
            DownloadTransactionModel!.CustomDateRangeError = "From date must be before the To date.";
            AddFieldError(CustomDateRangeKey, "From date must be before the To date.");
            return false;
        }
        if (start < DateOnly.FromDateTime(DateTime.Today).AddYears(-3))
        {
            DownloadTransactionModel!.CustomDateRangeError = "The From Date Cannot be more than 3 years ago.";
            AddFieldError(CustomDateRangeKey, "The From Date Cannot be more than 3 years ago.");
            return false;
        }
        return true;
    }
    private (string? startDate, string? endDate) ResolveDateRange()
    {
        var option = DownloadTransactionModel?.SelectedDateRangeOption?.ToLower();
        return option switch
        {
            "period" => (
                DownloadTransactionModel?.BenefitDateRangeModel?.CurrentWeek?.Start?.ToString("MM-dd-yyyy", CultureInfo.InvariantCulture),
                DownloadTransactionModel?.BenefitDateRangeModel?.CurrentWeek?.End?.ToString("MM-dd-yyyy", CultureInfo.InvariantCulture)
            ),
            "quarter" => (
                DownloadTransactionModel?.BenefitDateRangeModel?.QuarterYear?.Start?.ToString("MM-dd-yyyy", CultureInfo.InvariantCulture),
                DownloadTransactionModel?.BenefitDateRangeModel?.QuarterYear?.End?.ToString("MM-dd-yyyy", CultureInfo.InvariantCulture)
            ),
            "fiscal" => (
                DownloadTransactionModel?.BenefitDateRangeModel?.FiscalYear?.Start?.ToString("MM-dd-yyyy", CultureInfo.InvariantCulture),
                DownloadTransactionModel?.BenefitDateRangeModel?.FiscalYear?.End?.ToString("MM-dd-yyyy", CultureInfo.InvariantCulture)
            ),
            "statement" => (
                DateOnly.Parse(CustomStartDate ?? "", CultureInfo.InvariantCulture).ToString("MM-dd-yyyy", CultureInfo.InvariantCulture),
                DateOnly.Parse(CustomEndDate ?? "", CultureInfo.InvariantCulture).ToString("MM-dd-yyyy", CultureInfo.InvariantCulture)
            ),
            _ => (null, null)
        };
    }
    private void ApplyFileExtension()
    {
        var extension = DownloadTransactionModel?.FileTypeSelected switch
        {
            "1" => "txt",
            "2" => "csv",
            "6" => "xls",
            "3" => "xlsx",
            "4" => "prn",
            "5" => "xml",
            _ => null
        };
        if (extension != null)
        {
            DownloadTransactionModel!.DownloadReportRequest.FileExtension = extension;
        }
    }
    private async Task ExecuteDownloadAsync()
    {
        var request = DownloadTransactionModel?.DownloadReportRequest;
        if (request == null)
        {
            return;
        }
        try
        {
            var fileResponse = await DownloadTransactionService.DownloadOtherRFBTransactionsAsync(request);
            if (fileResponse == null || fileResponse.FileContent == null || fileResponse.FileContent.Length == 0)
            {
                ResetValidationState();
                if (DownloadTransactionModel != null)
                {
                    DownloadTransactionModel.NoRecordsFoundMessage = "There were no records found for your current date range chosen";
                }
                StateHasChanged();
                return;
            }
            var stream = new MemoryStream(fileResponse.FileContent);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("handleFileFromStream", fileResponse.FileName, streamRef, false);
        }
        catch (Exception)
        {
            ResetValidationState();
            _downloadErrorMessage = "We were unable to process your download request. Please try again, or contact support if the issue continues.";
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_validationModule is not null)
        {
            try
            {
                await _validationModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }
    }
}

