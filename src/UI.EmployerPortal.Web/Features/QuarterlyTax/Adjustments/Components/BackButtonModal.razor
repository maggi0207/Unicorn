@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleBackdropClick">
        <div class="modal-content" @onclick:stopPropagation="true" role="dialog" aria-modal="true" @ref="_modalElement">
            <div class="modal-header">
                @if(!string.IsNullOrEmpty(Title)){
                    <h3 class="modal-title">

                    @Title
                    </h3>
                }else{
                    <h3 class="modal-title">

                        Return to "Select Quarter & Year"?
                    </h3>
                }

                <button type="button"
                        class="modal-close"
                        @onclick="Close"
                        aria-label="Close">
                    x
                </button>
            </div>

            <div class="modal-body">
                  @if(!string.IsNullOrEmpty(Title)){
                    <p class="modal-text">
                        If you go back to change your Employee SSN,
                        employee data entered may no longer be valid.
                    </p>
                }
                else
                {
                     <p class="modal-text">
                    If you go back to change your quarter and year,
                    employee data entered may no longer be valid.
                </p>
                }

            </div>

            <div class="modal-footer">
                <Button Text="KEEP EMPLOYEE DATA"
                        Variant="Button.ButtonVariant.Secondary"
                        ShowBorder="false"
                        OnClick="Close" />

                <Button Text="REMOVE EMPLOYEE DATA"
                        Variant="Button.ButtonVariant.Secondary"
                        OnClick="RemoveDataConfirmed" />
            </div>
        </div>
    </div>
}

@code {

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Title { get; set; }

    [Parameter] public EventCallback<bool> OnClose { get; set; }

    [Parameter] public EventCallback OnRemoveDataConfirmed { get; set; }

    public bool CloseOnBackdropClick { get; set; } = false;

    private ElementReference _modalElement;
    private IJSObjectReference? _module;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FilterDrawer.js");
            await _module.InvokeVoidAsync("openFocusTrap", _modalElement);
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("closeFocusTrap");
            }
        }
    }

    private Task Close()
        => OnClose.InvokeAsync(true);

    private Task HandleBackdropClick() =>
     CloseOnBackdropClick? OnClose.InvokeAsync(true) : Task.CompletedTask;

    private Task RemoveDataConfirmed()
        => OnRemoveDataConfirmed.InvokeAsync();
}
