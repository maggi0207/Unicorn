@using System.Linq.Expressions
@using UI.EmployerPortal.Razor.SharedComponents.Inputs

<h1 class="heading">@Heading</h1>
<hr />
<p class="sub-text">@SubText</p>

<OutlinedSelectField Id="@Id"
                     Label="@Label"
                     Options="@quarterOptions"
                     Disabled="@Disabled"
                     For="@(For)"
                     Value="@Value"
                     ValueChanged="@(QuarterYearChanged)"
                     Required="@Required"
                     Placeholder="@Placeholder">
</OutlinedSelectField>

@code {
    [Parameter] public string Id { get; set; } = "quarter-year-select";
    [Parameter] public string Label { get; set; } = "Select Quarter & Year";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Required { get; set; } = true;
    [Parameter] public string Placeholder { get; set; } = "Quarter & Year";
    [Parameter] public string Heading { get; set; } = "Select Quarter & Year";
    [Parameter] public string SubText { get; set; } = "Select a previously submitted report to adjust.";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? For { get; set; }
    [Parameter] public int MaxItems { get; set; } = 20;
    [Parameter] public DateTime? StartFrom { get; set; }
    [Parameter] public IReadOnlyList<string>? AvailableQuarters { get; set; }

    private List<SelectOption> quarterOptions { get; set; } = new();

    protected override void OnInitialized()
    {
        CreateQuarterList();
    }

    protected override void OnParametersSet()
    {
        CreateQuarterList();
    }

    private void CreateQuarterList()
    {
        quarterOptions = new List<SelectOption>();

        if (AvailableQuarters is not null)
        {
            foreach (var quarterYear in AvailableQuarters)
            {
                quarterOptions.Add(new SelectOption
                {
                    Value = quarterYear,
                    Text = quarterYear
                });
            }
            return;
        }

        var startingDate = StartFrom ?? DateTime.Today;

        int currentQuarter = (startingDate.Month - 1) / 3 + 1;
        int year = startingDate.Year;

        for (int i = 0; i < MaxItems; i++)
        {
            var label = $"Q{currentQuarter} {year}";
            quarterOptions.Add(new SelectOption
            {
                Value = label,
                Text = label
            });

            currentQuarter--;
            if (currentQuarter == 0)
            {
                currentQuarter = 4;
                year--;
            }
        }
    }

    private async Task QuarterYearChanged(string? newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

}
