@using static UI.EmployerPortal.Razor.SharedComponents.Button

@if (IsOpen)
{
    <div class="remove-employee-backdrop" @onclick="HandleBackdropClick">
        <div class="remove-employee-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="remove-employee-title" @ref="_modalElement">
            <div class="modal-header">
                <h3 class="modal-title" id="remove-employee-title">Remove Employee?</h3>
                <button type="button" class="modal-close" @onclick="Close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="modal-body">
                <p class="modal-text">Are you sure you want to remove this employee from this wage adjustment?</p>
            </div>
            <div class="modal-footer">
                <Button Text="DO NOT REMOVE EMPLOYEE"
                        Variant="ButtonVariant.Secondary"
                        ShowBorder="false"
                        OnClick="Close" />
                <Button Text="REMOVE EMPLOYEE"
                        Variant="ButtonVariant.Secondary"
                        OnClick="Confirm" />
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private ElementReference _modalElement;
    private IJSObjectReference? _module;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FilterDrawer.js");
            await _module.InvokeVoidAsync("openFocusTrap", _modalElement);
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("closeFocusTrap");
            }
        }
    }
    private Task Close() => OnClose.InvokeAsync();
    private Task HandleBackdropClick() => Close();
    private Task Confirm() => OnConfirm.InvokeAsync();
}
