@if (IsOpen)
{
    <div class="cancel-tax-upload-backdrop">
        <div class="cancel-tax-upload-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="cancel-tax-upload-title" @ref="_modalElement">
            <div class="cancel-tax-upload-header">
                <h3 id="cancel-tax-upload-title" class="cancel-tax-upload-title">Cancel Processing?</h3>
                <button type="button" class="cancel-tax-upload-close" @onclick="Close" disabled="@IsBusy" aria-label="Close">x</button>
            </div>

            <div class="cancel-tax-upload-body">
                <p class="cancel-tax-upload-text">
                    Do you want to cancel processing this file?
                </p>
            </div>

            <div class="cancel-tax-upload-footer" role="group" aria-label="Cancel Processing Actions">
                <Button Text="RETURN TO PAGE"
                        Variant="Button.ButtonVariant.Secondary"
                        ShowBorder="false"
                        Disabled="@IsBusy"
                        AriaLabel="Return to page"
                        OnClick="Close" />
                <Button Text="@(IsBusy ? "CANCELLING..." : "CONFIRM")"
                        Variant="Button.ButtonVariant.Secondary"
                        Disabled="@IsBusy"
                        AriaLabel="Confirm cancel processing"
                        OnClick="Confirm" />
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    /// <summary>
    /// Gets or sets whether the modal is visible.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Gets or sets whether the cancel request is in progress, disabling the modal's buttons.
    /// </summary>
    [Parameter]
    public bool IsBusy { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the modal is dismissed without confirming.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user confirms the cancellation.
    /// </summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }
    private ElementReference _modalElement;
    private IJSObjectReference? _module;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FilterDrawer.js");
            await _module.InvokeVoidAsync("openFocusTrap", _modalElement);
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("closeFocusTrap");
            }
        }
    }

    private Task Close()
    {
        return OnClose.InvokeAsync();
    }

    private Task Confirm()
    {
        return OnConfirm.InvokeAsync();
    }
}
