@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using UI.EmployerPortal.Web.Features.QuarterlyTax.Models

@if (IsOpen)
{
    <div class="modal-backdrop">
        <div class="modal-content" @onclick:stopPropagation="true" role="dialog" aria-modal="true" @ref="_modalElement">
            <div class="modal-header">
                <h3 class="modal-title">Save Employee Without Wages?</h3>
                <button type="button" class="modal-close" @onclick="Close" aria-label="Close">x</button>
            </div>

            <div class="modal-body">
                <p class="modal-text">
                    You have indicated that one or more of your employees have zero wages for this
                    quarter. Would you like to save them for next quarter?
                </p>
            </div>
            <div class="modal-footer">
                <Button Text="DO NOT SAVE EMPLOYEES"
                        Variant="Button.ButtonVariant.Secondary"
                        ShowBorder="false"
                        OnClick="DoNotSave" />
                <Button Text="SAVE EMPLOYEES"
                        Variant="Button.ButtonVariant.Secondary"
                        OnClick="Save" />
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EmployeeWageEntryData> OnDoNotSave { get; set; }
    private ElementReference _modalElement;
    private IJSObjectReference? _module;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FilterDrawer.js");
            await _module.InvokeVoidAsync("openFocusTrap", _modalElement);
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("closeFocusTrap");
            }
        }
    }

    private Task Close() => OnClose.InvokeAsync();
    private Task HandleBackdropClick() => Close();
    private Task Save() => OnClose.InvokeAsync();
    private Task DoNotSave() => OnDoNotSave.InvokeAsync();
}
