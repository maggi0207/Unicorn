@if (IsOpen)
{
    <div class="modal-backdrop">
        <div class="modal-content" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
             aria-labelledby="missing-prior-title" aria-describedby="missing-prior-description" @ref="_modalElement">
            <div class="modal-header">
                <h3 id="missing-prior-title" class="modal-title">Missing Prior Quarter Reports</h3>
                <button type="button" class="modal-close" @onclick="HandleCancel" aria-label="Close">x</button>
            </div>
            <div class="modal-body">
                <p id="missing-prior-description" class="modal-text">
                    There are missing wage reports for prior quarters for the same year. The exclusion and
                    taxable payroll amounts listed cannot be calculated accurately. To resolve this, please
                    file all missing reports in sequential order with respect to calendar year.
                </p>
            </div>
            <div class="modal-footer">
                <Button Text="CANCEL"
                        Variant="Button.ButtonVariant.Secondary"
                        ShowBorder="false"
                        OnClick="HandleCancel" />
                <Button Text="OK"
                        Variant="Button.ButtonVariant.Secondary"
                        OnClick="HandleConfirm" />
            </div>
        </div>
    </div>
}
@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    private ElementReference _modalElement;
    private IJSObjectReference? _module;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FilterDrawer.js");
            await _module.InvokeVoidAsync("openFocusTrap", _modalElement);
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("closeFocusTrap");
            }
        }
    }
    private Task HandleCancel() => OnCancel.InvokeAsync();
    private Task HandleConfirm() => OnConfirm.InvokeAsync();
}
