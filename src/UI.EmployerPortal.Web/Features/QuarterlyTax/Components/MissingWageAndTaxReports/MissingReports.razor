@using Microsoft.AspNetCore.Components.Forms
@using UI.EmployerPortal.Web.Auth
@using UI.EmployerPortal.Web.Features.Shared.Accounts.Services
@using UI.EmployerPortal.Web.Startup.ResiliencyProtocols

<CascadingValue Value="_pendingEditContext" IsFixed="false">
    <ValidationErrorSummary ShowSummary="@_showPendingErrorrs"
                            FieldIds="@_pendingFieldIds"
                            SummaryId="pending-validation-summary" />
</CascadingValue>
@if (_hasPendingReports)
{
    <div class="active-audit" role="alert" aria-label="Pending Report">
        @GetActiveAuditIcon()
        <span class="error-text"><strong>Pending Report: </strong>You must complete your current report before filing another report.</span>
    </div>
    <br />
    <h2 class="missing-report-title">Pending Reports</h2>
    <div class="table-container">
        <table id="pending-reports-table" tabindex="-1" class="table" style="table-layout: fixed; width: 100%;" aria-label="Pending Reports">
            <caption class="visually-hidden">List of pending reports in progress</caption>
            <thead>
                <tr class="header-row">
                    <th scope="col" class="header-cell" style="width: 16%">
                        <div class="header-content header-content-left">
                            <span class="header-label fw-bold fs-sm">Quarter</span>
                        </div>
                    </th>
                    <th scope="col" class="header-cell" style="width: 26%">
                        <div class="header-content header-content-left">
                            <span class="header-label fw-bold fs-sm">Report Name</span>
                        </div>

                    </th>
                    <th scope="col" class="header-cell" style="width: 38%">
                        <div class="header-content header-content-left">
                            <span class="header-label fw-bold fs-sm">Status & Due Date</span>
                        </div>
                    </th>
                    <th scope="col" class="header-cell" style="width: 20%">
                        <div class="header-content header-content-left">
                            <span class="header-label fw-bold fs-sm">Actions</span>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pending in ReportData.PendingReports)
                {
                    var matchingReport = ReportData.MissingReports.FirstOrDefault(r => r.Quarter == pending.Quarter && r.Year == pending.Year);
                    <tr class="custom-row">
                        <td>Q@(pending.Quarter) @(pending.Year)</td>
                        <td>@GetReportNameByFilingSelectionType(pending.ReportingSelectionCodeSK)</td>
                        <td class="pending-status">In Progress</td>
                        <td>
                            <Button Text="CONTINUE"
                                    OnClick="async () => await HandleContinuePendingReport(pending, matchingReport)"
                                    AriaLabel="@($"Continue pending report Q{pending.Quarter} {pending.Year}")"
                                    Size="Button.ButtonSize.Small"
                                    Variant="Button.ButtonVariant.Secondary"
                                    ShowBorder="false" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <br />
}

@if (_hasActiveAudit)
{
    <div class="active-audit" role="alert" aria-label=@($"{AuditWarning} {AuditText}")>
        @GetActiveAuditIcon()
        <span class="error-text"><strong>@AuditWarning</strong>@AuditText</span>
    </div>
    <br />
}

@if (_hasMissingReports)
{
    <div class="missing-reports" role="alert" aria-label=@($"{MissingReportsWarning} {MissingReportsText}")>
        @GetMissingReportsIcon()
        <span class="error-text"><strong>@MissingReportsWarning</strong>@MissingReportsText</span>
    </div>
    <br />
}
<br />

<h2 class="missing-report-title">Quarterly Reports</h2>
<div class="table-container">
    <table class="table" style="table-layout: fixed; width: 100%;" aria-label="Missing Wage And Tax Reports">
        <caption class="visually-hidden">List of missing wage and tax reports (column headers with buttons are sortable)</caption>
        <thead>
            <tr class="header-row">
                <th scope="col" class="header-cell" style="width: 16%" aria-sort="@GetAriaSort("quarter")">
                    <div class="header-content header-content-left">
                        <button type="button" class="header-sort-button" @onclick="@(() => Sort("quarter"))">
                            <span class="header-label fw-bold fs-sm">Quarter</span>
                            <span aria-hidden="true">@GetSortIcon("quarter")</span>
                        </button>
                    </div>
                </th>
                <th scope="col" class="header-cell" style="width: 26%" aria-sort="@GetAriaSort("reportName")">
                    <div class="header-content header-content-left">
                        <button type="button" class="header-sort-button" @onclick="@(() => Sort("reportName"))">
                            <span class="header-label fw-bold fs-sm">Report Name</span>
                            <span aria-hidden="true">@GetSortIcon("reportName")</span>
                        </button>
                    </div>
                </th>
                <th scope="col" class="header-cell" style="width: 38%" aria-sort="@GetAriaSort("statusDueDate")">
                    <div class="header-content header-content-left">
                        <button type="button" class="header-sort-button" @onclick="@(() => Sort("statusDueDate"))">
                            <span class="header-label fw-bold fs-sm">Status & Due Date</span>
                            <span aria-hidden="true">@GetSortIcon("statusDueDate")</span>
                        </button>
                    </div>
                </th>
                <th scope="col" class="header-cell" style="width: 20%" aria-sort="@GetAriaSort("actions")">
                    <div class="header-content header-content-left">
                        <button type="button" class="header-sort-button" @onclick="@(() => Sort("actions"))">
                            <span class="header-label fw-bold fs-sm">Actions</span>
                            <span aria-hidden="true">@GetSortIcon("actions")</span>
                        </button>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (_gridData != null)
            {
                foreach (var report in _gridData)
                {
                    <tr class="custom-row">
                        <td>@report.FormattedQuarterYear</td>
                        <td>@report.ReportName</td>
                        <td class="@GetStatusCss(report)">
                            @GetReportIcon(report)
                            @($"{report.Status} Due {report.DueDate: MM/dd/yyyy}")
                        </td>
                        <td class="fw-normal fs-md">
                            <Button ShowBorder="false"
                                    OnClick="async() => await HandleFileReport(report)"
                                    Text="File Report"
                                    AriaLabel="@($"File Report for {report.FormattedQuarterYear} {report.ReportName}")"
                                    Size="Button.ButtonSize.Small"
                                    Variant="Button.ButtonVariant.Secondary"
                                    Disabled="@IsFileReportDisabled(report)" />

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<ReportingQuarterOutOfOrderModal IsOpen="_showOutOfOrderModal"
                                 QuarterDisplay="@(_pendingReport?.FormattedQuarterYear ?? "")"
                                 OnCancel="HandleOutOfOrderCancel"
                                 OnConfirm="HandleOutOfOrderConfirm" />
