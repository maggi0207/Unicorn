@using UI.EmployerPortal.Razor.SharedComponents.Inputs
@using UI.EmployerPortal.Web.Features.QuarterlyTax.Models

@if (IsOpen)
{
    <div class="modal-backdrop">
        <div class="modal-content" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="save-and-quit-modal-title" @ref="_modalElement">
            <div class="modal-header">
                <h3 id="save-and-quit-modal-title" class="modal-title">Save and Quit?</h3>
                <button type="button" class="modal-close" @onclick="Close" aria-label="Close">x</button>
            </div>

            <div class="modal-body">
                <p class="modal-text">
                    Your report has not been submitted. Would you like to save your progress
                    and return later to complete this report?
                </p>
                @if (HasSubjectivity)
                {
                    <p class="modal-text mt-2">
                        <strong>Note:</strong> Subjectivity question responses are not saved with drafts and will need to be re-entered when you return.
                    </p>
                }
            </div>
            <div class="modal-footer">
                <Button Text="CANCEL"
                        Variant="Button.ButtonVariant.Secondary"
                        ShowBorder="false"
                        OnClick="Close" />
                <Button Text="SAVE AND QUIT"
                        Variant="Button.ButtonVariant.Secondary"
                        OnClick="Confirm" />
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool HasSubjectivity { get; set; }
    [Parameter] public EventCallback<EmployeeWageEntryData> OnConfirm { get; set; }

    private ElementReference _modalElement;
    private IJSObjectReference? _module;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FilterDrawer.js");
            await _module.InvokeVoidAsync("openFocusTrap", _modalElement);
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("closeFocusTrap");
            }
        }
    }

    private Task Close() => OnClose.InvokeAsync();
    private Task HandleBackdropClick() => Close();
    private Task Confirm() => OnConfirm.InvokeAsync();
}
