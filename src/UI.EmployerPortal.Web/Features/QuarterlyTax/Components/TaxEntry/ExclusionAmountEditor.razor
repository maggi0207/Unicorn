@using UI.EmployerPortal.Razor.SharedComponents.Helpers
@using UI.EmployerPortal.Razor.SharedComponents.TextBoxes
@using UI.EmployerPortal.Web.Features.QuarterlyTax.Models
@using UI.EmployerPortal.Web.Features.Shared.QuarterlyTax.Models
@using UI.EmployerPortal.Web.Features.QuarterlyTax.Components

<div class="input-wrapper input-with-icon">
    <NumericTextBox Id="exclusion-amount"
                    AriaLabel="Exclusion Amount"
                    Value="@ExclusionOverride.EffectiveAmount"
                    InputType="@InputDataTypes.Currency"
                    Max=99999999999999
                    IsReadonly="true"
                    CssClass="form-control textboxReadOnlyBackgroundColor exclusion pencil"
                    AriaDescribedby="exculsion-amount-hint" />

    <span class="field-icon"
          role="button"
          tabindex="0"
          @onclick="@(() => OpenUpdateExclusionsModal())"
          @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") OpenUpdateExclusionsModal(); })"
          aria-label="Edit exclusion amount"
          aria-describedby="exclusion-amount-hint">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#003663" aria-hidden="true">
            <path d="M19.045 7.401c.378-.378.586-.88.586-1.414s-.208-1.036-.586-1.414l-1.586-1.586c-.378-.378-.88-.586-1.414-.586s-1.036.208-1.413.585L4 13.585V18h4.413L19.045 7.401zm-3-3 1.587 1.585-1.59 1.584-1.586-1.585 1.589-1.584zM6 16v-1.585l7.04-7.018 1.586 1.586L7.587 16H6z" />
        </svg>
    </span>

    <div class="Lower-text" id="exculsion-amount-hint" role="note">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 4px;" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20ZM11 11H13V17H11V11ZM11 7H13V9H11V7Z" fill="#003366" />
        </svg>
        <span style="vertical-align: middle;">Requires a reason to edit</span>
    </div>
</div>
@if (IsUpdateExclusionsModalOpen)
{
    <UpdateExclusionAmountModal IsOpen="IsUpdateExclusionsModalOpen"
                                ExclusionOverride="ExclusionOverride"
                                TotalGrossCoveredWages="TotalGrossCoveredWages"
                                ReasonOptions="ExclusionReasons"
                                OnClose="CloseUpdateExclusionsModal"
                                OnUpdate="HandleUpdateExclusions" />
}

@code {
    [Parameter]
    public ExclusionOverrideModel ExclusionOverride { get; set; } = default!;

    [Parameter]
    public EventCallback OnExclusionUpdated { get; set; }

    [Parameter]
    public List<string> ExclusionReasons { get; set; } = new();

    [Parameter]
    public decimal TotalGrossCoveredWages { get; set; }

    private bool IsUpdateExclusionsModalOpen = false;

    private void OpenUpdateExclusionsModal()
    {
        IsUpdateExclusionsModalOpen = true;
        StateHasChanged();
    }

    private Task CloseUpdateExclusionsModal()
    {
        IsUpdateExclusionsModalOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleUpdateExclusions()
    {
        await OnExclusionUpdated.InvokeAsync();
        IsUpdateExclusionsModalOpen = false;
    }
}

