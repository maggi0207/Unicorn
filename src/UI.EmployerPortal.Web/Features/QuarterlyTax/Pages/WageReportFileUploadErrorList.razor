@page "/quarterly-tax/wage-report-file-upload-error-list"

<PageTitle>Wage File Upload Error List</PageTitle>

<div class="wuel-page">

    <div class="wuel-header">
        <h1 class="wuel-title">Wage File Upload Error List</h1>
        <p class="wuel-subtitle fs-md">
            This screen displays the error numbers and error messages for all errors that could be found in a wage report upload file, as well as information about the actions necessary to correct the errors.
        </p>
    </div>

    <div class="table-container">
        <table class="table" style="table-layout: fixed; width: 100%;" aria-label="Wage report file upload error list">
            <caption class="visually-hidden">Wage report file upload error numbers, messages, and corrective actions</caption>
            <colgroup>
                <col style="width: 90px;" />
                <col style="width: 280px;" />
                <col />
            </colgroup>
            <thead>
                <tr class="header-row">
                    <th scope="col" class="header-cell header-cell-static">
                        <div class="header-content header-content-left">
                            <span class="header-label fw-bold fs-md">Error #</span>
                        </div>
                    </th>
                    <th scope="col" class="header-cell header-cell-static">
                        <div class="header-content header-content-left">
                            <span class="header-label fw-bold fs-md">Error Message</span>
                        </div>
                    </th>
                    <th scope="col" class="header-cell header-cell-static">
                        <div class="header-content header-content-left">
                            <span class="header-label fw-bold fs-md">Corrective Action</span>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in _errors)
                {
                    <tr class="data-row">
                        <th scope="row" class="fw-bold fs-md">@error.Number</th>
                        <td class="fw-normal fs-md">@error.Message</td>
                        <td class="fw-normal fs-md">@((MarkupString)error.CorrectiveAction)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    private record ErrorEntry(int Number, string Message, string CorrectiveAction);

